---
import {
  site,
  locations,
  isFilled,
  mapsEmbedUrl,
  mapsDirectionsUrl,
} from '@/data/site';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Treatments',
    links: [
      { label: 'All drips', href: '/drips' },
      { label: 'The Injection Bar', href: '/shots' },
      { label: 'Ingredient library', href: '/ingredients' },
      { label: 'Build your own', href: '/drips/build-your-own' },
    ],
  },
  {
    heading: 'Clinical',
    links: [
      { label: 'Iron therapy', href: '/iron-therapy' },
      { label: 'Metabolic program', href: '/metabolic-program' },
      { label: 'Safety & screening', href: '/safety' },
      { label: 'How it works', href: '/how-it-works' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'Clinic',
    links: [
      { label: 'By concern', href: '/concerns' },
      { label: 'Pricing & memberships', href: '/pricing' },
      { label: 'The Journal', href: '/journal' },
      { label: 'About', href: '/about' },
      { label: 'Contact', href: '/contact' },
    ],
  },
];
---

<footer class="footer">
  <div class="wrap footer__top">
    <div class="footer__brand">
      <p class="footer__name hl">{site.line}</p>
      <p class="eyebrow">{site.parentNote} · {site.tagline}</p>
      <p class="footer__pitch measure">
        Wellness and clinical care, built around how you want to feel.
        Reviewed by our physician, given by our nurses.
      </p>
      <div class="footer__socials">
        <SocialLinks />
      </div>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      {columns.map((col) => (
        <div class="footer__col">
          <p class="footer__heading">{col.heading}</p>
          <ul>
            {col.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="wrap footer__bottom">
    <div class="footer__locations">
      {locations.map((loc) => (
        <div class="footer__loc">
          <p class="footer__loc-title">{loc.name}</p>
          {isFilled(loc.address) && <p class="footer__meta">{loc.address}</p>}
          {isFilled(loc.hours) && <p class="footer__meta">{loc.hours}</p>}
          {isFilled(loc.address) && (
            <a
              class="footer__map"
              href={mapsDirectionsUrl(loc.address)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Get directions to ${loc.name} on Google Maps`}
            >
              <span class="footer__map-frame">
                <iframe
                  src={mapsEmbedUrl(loc.address)}
                  title={`Map of ${loc.name}`}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  tabindex="-1"
                  aria-hidden="true"
                />
              </span>
              <span class="footer__map-cta">
                Get directions
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          )}
        </div>
      ))}
    </div>

    <div class="footer__legal">
      <p class="footer__fine">
        Wellness infusion services are elective and are not covered by OHIP.
        Iron therapy may be clinically indicated. Every treatment is
        physician-reviewed and nurse-administered. Information on this site is
        educational and is not medical advice. Results vary from person to
        person. A consult confirms what is right for you.
      </p>
      <p class="footer__fine">
        &copy; {year} {site.brand}. {site.signOff}
      </p>
      <p class="footer__legallinks">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Use</a>
        <a href="/accessibility">Accessibility</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    /* Instead of a hard white border: a hairline that fades out toward both
       ends, over a faint glow spilling down into the footer. Layered as
       backgrounds so they sit behind the content, never washing the text. */
    background:
      linear-gradient(
          to right,
          transparent,
          rgba(252, 252, 253, 0.22) 28%,
          rgba(252, 252, 253, 0.22) 72%,
          transparent
        )
        top / 100% 1px no-repeat,
      linear-gradient(to bottom, rgba(252, 252, 253, 0.05), transparent 140px),
      var(--surface-dark);
    color: var(--on-dark);
    padding-block: var(--space-l) var(--space-m);
  }
  .footer a {
    color: inherit;
    text-decoration: none;
  }
  .footer__top {
    display: grid;
    grid-template-columns: 1.3fr 2fr;
    gap: 3rem;
    padding-bottom: var(--space-l);
    border-bottom: 1px solid rgba(252, 252, 253, 0.14);
  }
  .footer__name {
    font-size: var(--step-2);
    margin-bottom: 0.4rem;
  }
  .footer .eyebrow {
    color: rgba(252, 252, 253, 0.6);
  }
  .footer__pitch {
    margin-top: 1rem;
    color: rgba(252, 252, 253, 0.75);
  }
  .footer__socials {
    margin-top: 1.6rem;
  }
  .footer__nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .footer__heading {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(252, 252, 253, 0.55);
    margin-bottom: 1rem;
  }
  .footer__loc-title {
    font-family: var(--display);
    font-weight: 400;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    color: var(--on-dark);
    margin-bottom: 0.7rem;
  }
  .footer__col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .footer__col a:hover {
    color: rgba(252, 252, 253, 0.65);
  }
  .footer__locations {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    padding-block: var(--space-l);
    border-bottom: 1px solid rgba(252, 252, 253, 0.14);
  }
  .footer__meta {
    color: rgba(252, 252, 253, 0.72);
    font-size: var(--step--1);
  }
  .footer__map {
    display: block;
    margin-top: 0.9rem;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(252, 252, 253, 0.14);
    background: rgba(252, 252, 253, 0.04);
    transition:
      border-color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .footer__map:hover {
    border-color: rgba(252, 252, 253, 0.4);
    transform: translateY(-2px);
  }
  .footer__map:focus-visible {
    outline: 2px solid var(--on-dark);
    outline-offset: 2px;
  }
  .footer__map-frame {
    display: block;
    position: relative;
    height: 130px;
  }
  /* The iframe is a visual only; pointer-events off so a click anywhere on the
     card falls through to the anchor and opens directions. A subtle tint keeps
     the map on-brand against the dark footer. */
  .footer__map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
    filter: grayscale(0.35) contrast(0.95) brightness(0.96);
  }
  .footer__map-cta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.7rem;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(252, 252, 253, 0.8);
    border-top: 1px solid rgba(252, 252, 253, 0.12);
  }
  .footer__map:hover .footer__map-cta {
    color: var(--on-dark);
  }
  .footer__map:hover .footer__map-cta svg {
    transform: translateX(3px);
  }
  .footer__map-cta svg {
    transition: transform 0.3s var(--ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .footer__map,
    .footer__map-cta svg {
      transition: none;
    }
  }
  .footer__legal {
    padding-top: var(--space-m);
    display: grid;
    gap: 0.8rem;
  }
  .footer__fine {
    color: rgba(252, 252, 253, 0.5);
    font-size: 0.78rem;
    line-height: 1.6;
    max-width: 70ch;
  }
  .footer__legallinks {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }
  .footer__legallinks a {
    color: rgba(252, 252, 253, 0.6);
  }
  .footer__legallinks a:hover {
    color: var(--on-dark);
  }
  @media (max-width: 820px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .footer__nav,
    .footer__locations {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .footer__nav,
    .footer__locations {
      grid-template-columns: 1fr;
    }
  }
</style>
