---
import type { Treatment } from '@/data/treatments';
import { families } from '@/data/families';

export interface Props {
  treatment: Treatment;
}
const { treatment } = Astro.props;
const fam = families[treatment.family];
const href =
  treatment.type === 'drip'
    ? `/drips/${treatment.slug}`
    : `/shots/${treatment.slug}`;
// Cards carry the family accent. This is one of only two places (with the
// mega-menu) where the black-and-white page blooms into colour.
const dots = treatment.ingredients.slice(0, 5);
---

<a
  class="card"
  href={href}
  style={`--accent: var(--accent-${treatment.family}); --accent-text: ${fam.text}`}
>
  <span class="card__rule" aria-hidden="true"></span>
  <span class="card__top">
    <span class="card__family">{fam.label}</span>
    <span class="card__type">{treatment.type === 'drip' ? 'Drip' : 'Shot'}</span>
  </span>
  <span class="card__name">{treatment.name}</span>
  <span class="card__essence">{treatment.essence}</span>
  <span class="card__dots" aria-hidden="true">
    {dots.map(() => <span class="card__dot"></span>)}
  </span>
  <span class="card__more link-arrow">Learn more &rarr;</span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.6rem 1.4rem 1.3rem;
    /* High gloss sparkle white: glossy gradient with a faint fleck layer. */
    background-color: var(--white-pure);
    background-image: var(--sparkle), var(--gloss-white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  /* The gloss reflection, a soft diagonal sheen that sweeps on hover. */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      125deg,
      transparent 40%,
      rgba(255, 255, 255, 0.55) 50%,
      transparent 60%
    );
    transform: translateX(-60%);
    opacity: 0;
    transition: opacity 0.4s var(--ease), transform 0.6s var(--ease);
    pointer-events: none;
  }
  .card__rule {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--accent);
    opacity: 0.85;
  }
  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.4rem;
  }
  .card__family {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .card__type {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mist);
  }
  .card__name {
    font-family: var(--display);
    font-size: var(--step-1);
    color: var(--ink);
    line-height: 1.15;
  }
  .card__essence {
    color: var(--graphite);
    font-size: var(--step--1);
    line-height: 1.5;
    flex: 1;
  }
  .card__dots {
    display: flex;
    gap: 5px;
    margin-top: 0.4rem;
  }
  .card__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.5;
  }
  .card__more {
    margin-top: 0.6rem;
    border-color: transparent;
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translateY(-3px);
      border-color: var(--accent);
      box-shadow: 0 18px 34px -22px rgba(26, 27, 29, 0.32);
    }
    .card:hover::after {
      opacity: 1;
      transform: translateX(60%);
    }
    .card:hover .card__dot {
      opacity: 0.9;
    }
    .card:hover .card__more {
      border-color: var(--ink);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card::after {
      display: none;
    }
  }
</style>
