---
import type { Ingredient } from '@/data/ingredients';

export interface Props {
  ingredient: Ingredient;
  showLine?: boolean;
}
const { ingredient, showLine = false } = Astro.props;
---

<a
  class={`chip ${showLine ? 'chip--line' : ''}`}
  href={`/ingredients/${ingredient.slug}`}
  style={`--dot: var(--accent-${ingredient.family})`}
>
  <span class="chip__dot" aria-hidden="true"></span>
  <span class="chip__name">{ingredient.name}</span>
  {showLine && <span class="chip__line">{ingredient.oneLine}</span>}
</a>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    text-decoration: none;
    font-size: var(--step--1);
    color: var(--ink);
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .chip__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dot);
    flex: none;
  }
  .chip--line {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 0.7rem;
    border-radius: var(--radius);
    padding: 0.7rem 0.9rem;
    width: 100%;
  }
  .chip--line .chip__dot {
    grid-row: span 2;
    align-self: center;
  }
  .chip__line {
    grid-column: 2;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--mist);
    letter-spacing: 0.01em;
  }
  @media (hover: hover) and (pointer: fine) {
    .chip:hover {
      border-color: var(--ink);
      background: var(--cloud);
    }
  }
</style>
