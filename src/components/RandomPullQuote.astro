---
import { pullQuotes } from '@/data/quotes';

// Oversized pull-quote that shows a random line from the table on each visit.
// A build-time pick is rendered as the no-JS fallback; the client re-rolls on
// load (invisible, since the quote starts hidden behind the reveal).
export interface Props {
  cite?: string;
  accent?: string;
}
const { cite = 'Refined by Medicine', accent } = Astro.props;
const initial = pullQuotes[Math.floor(Math.random() * pullQuotes.length)];
---

<figure class="pq reveal" style={accent ? `--pq-accent:${accent}` : undefined}>
  <span class="pq__mark" aria-hidden="true"></span>
  <blockquote class="pq__q ripple" data-rquote>{initial}</blockquote>
  <figcaption class="pq__cite">{cite}</figcaption>
</figure>

<script define:vars={{ quotes: pullQuotes }}>
  document.querySelectorAll('[data-rquote]').forEach((el) => {
    if (Array.isArray(quotes) && quotes.length) {
      el.textContent = quotes[Math.floor(Math.random() * quotes.length)];
    }
  });
</script>

<style>
  .pq {
    margin: 0;
    padding-block: clamp(3rem, 7vw, 6rem);
    display: grid;
    justify-items: center;
    gap: 1.4rem;
    text-align: center;
  }
  .pq__mark {
    width: 38px;
    height: 3px;
    border-radius: 3px;
    background: var(--pq-accent, var(--ink));
    opacity: 0.85;
  }
  .pq__q {
    margin: 0;
    font-family: var(--display);
    font-weight: 360;
    font-size: var(--step-4);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 20ch;
    text-wrap: balance;
  }
  .pq__cite {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mist);
  }
</style>
