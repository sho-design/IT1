---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CtaBand from '@/components/CtaBand.astro';

const forYou = [
  'Generally healthy adults wanting wellness support',
  'People feeling run down, low on energy, or depleted',
  'Anyone wanting care in a calm, physician-led setting',
  'Patients with clinically indicated needs, such as low iron',
];
const notFor = [
  'Anyone seeking guaranteed outcomes or a cure',
  'A replacement for diagnosis or treatment of a medical condition',
  'Some health situations where we will adjust or decline, for your safety',
];
const screen = [
  { t: 'Pregnancy & breastfeeding', d: 'Some ingredients are not advised. Tell us, and we will adjust or wait.' },
  { t: 'Kidney function', d: 'The kidneys clear minerals like magnesium, so we review kidney health before certain drips.' },
  { t: 'Heart conditions', d: 'Fluid volume and certain ingredients matter here, so we screen and pace carefully.' },
  { t: 'Allergies & reactions', d: 'We ask about past reactions to any ingredient and plan accordingly.' },
  { t: 'G6PD deficiency', d: 'High-dose vitamin C is screened against this, and we adjust where needed.' },
  { t: 'Medications', d: 'We review your medications for any interactions before we proceed.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: 'Safety and screening',
  description:
    'Who infusion therapy is and is not for, the screening process, and the conditions we screen for at Restoration Medical.',
  url: new URL('/safety', Astro.site).href,
};
---

<Layout
  title="Safety"
  description="Is infusion therapy right for me? Who it is and is not for, our screening process, and the conditions we screen for at Restoration Medical. Physician-led, honest, careful."
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="Is this right for me?"
    lead="Trust is built on honesty. Here is who infusion therapy is for, who it is not for, and exactly how we screen, so you know what to expect before you arrive."
  >
    Safe, screened, <span class="it">and honest about it.</span>
  </PageHeader>

  <section class="section-tight">
    <div class="wrap two">
      <div class="reveal panel">
        <p class="eyebrow">A good fit</p>
        <ul class="list">
          {forYou.map((f) => (
            <li class="list__item list__item--yes"><span class="list__mark" aria-hidden="true"></span>{f}</li>
          ))}
        </ul>
      </div>
      <div class="reveal panel panel--soft">
        <p class="eyebrow">When it is not the answer</p>
        <ul class="list">
          {notFor.map((f) => (
            <li class="list__item"><span class="list__mark list__mark--no" aria-hidden="true"></span>{f}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-tight fill">
    <div class="wrap">
      <div class="reveal sec-head">
        <p class="eyebrow">The screening process</p>
        <h2 class="hl display-3">What we check, and why.</h2>
        <p class="lead">
          Before any treatment, we review your health so that what we give you is
          safe and sensible. This is the part a drip bar skips.
        </p>
      </div>
      <div class="grid reveal">
        {screen.map((s) => (
          <article class="scard">
            <h3 class="scard__t">{s.t}</h3>
            <p class="scard__d">{s.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap-narrow reveal">
      <div class="block">
        <h2 class="block__h">We may adjust or decline, and that is the point</h2>
        <p class="block__p">
          If a treatment is not right or safe for you, we will say so, adjust the
          plan, or decline on clinical grounds. That honesty is what makes this a
          medical clinic. Wellness services are elective and not covered by OHIP.
          Iron therapy may be clinically indicated. Nothing here is a guarantee,
          and results vary from person to person.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Reassured?"
    heading="Bring your questions to a consult."
    body="A consult is the right place to talk through your health and whether infusion therapy fits. We would rather have that conversation than rush you into a chair."
  />
</Layout>

<style>
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .panel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem;
    display: grid;
    gap: 1.2rem;
    align-content: start;
  }
  .panel--soft {
    background: var(--cloud);
  }
  .list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  .list__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.8rem;
    align-items: baseline;
    color: var(--graphite);
  }
  .list__mark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-metabolic);
    transform: translateY(-1px);
  }
  .list__mark--no {
    background: var(--mist);
    border-radius: 1px;
  }
  .sec-head {
    display: grid;
    gap: 0.8rem;
    margin-bottom: var(--space-m);
    max-width: 60ch;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.2rem;
  }
  .scard {
    border-top: 1px solid var(--ink);
    padding-top: 1.1rem;
    display: grid;
    gap: 0.5rem;
  }
  .scard__t {
    font-size: var(--step-1);
  }
  .scard__d {
    color: var(--graphite);
    font-size: var(--step--1);
  }
  .block__h {
    font-size: var(--step-2);
    margin-bottom: 1rem;
    max-width: 22ch;
  }
  .block__p {
    color: var(--graphite);
    font-size: var(--step-1);
    line-height: 1.55;
  }
  @media (max-width: 820px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
</style>
