---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CtaBand from '@/components/CtaBand.astro';
import RandomPullQuote from '@/components/RandomPullQuote.astro';
import { team } from '@/data/team';
import { isFilled, locations } from '@/data/site';

const [lead, ...rest] = team;

const standards = [
  { t: 'Physician-reviewed', d: 'Every plan is reviewed by our physician before treatment — eligibility, dosing, and follow-up.' },
  { t: 'Nurse-administered', d: 'Registered nurses place every line and stay with you through the visit.' },
  { t: 'Screened first', d: 'We take a history and screen before we treat. If something is not right for you, we say so.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  name: 'Restoration Medical',
  description:
    'The physician-led care team behind Infusion Therapy at Restoration Medical, serving Thornhill and Maple.',
  url: Astro.site?.href,
  areaServed: locations.map((l) => l.name),
  employee: team.map((m) => ({
    '@type': 'Person',
    ...(isFilled(m.name) ? { name: m.name } : {}),
    jobTitle: m.role,
  })),
};
---

<Layout
  title="Our team"
  description="Meet the physician-led care team behind Infusion Therapy at Restoration Medical. A physician reviews, registered nurses administer, and every visit is screened first."
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="Our team · Refined by Medicine"
    accent="var(--accent-clinical)"
    lead="Infusion therapy here is delivered by people, not a counter. A physician reviews every plan; registered nurses give every treatment. Calm, careful, and accountable."
  >
    The people behind <span class="it">your care.</span>
  </PageHeader>

  <section class="section-tight">
    <div class="wrap">
      <article
        class:list={['lead-member reveal', { 'lead-member--3col': lead.highlights?.length }]}
        style={`--fam:${lead.family}`}
      >
        <div class="lead-member__portrait">
          {isFilled(lead.photo) ? (
            <img src={lead.photo} alt={isFilled(lead.name) ? lead.name : lead.role} loading="lazy" />
          ) : (
            <span class="lead-member__mono" aria-hidden="true">{lead.monogram}</span>
          )}
        </div>
        <div class="lead-member__body">
          <p class="eyebrow lead-member__eyebrow">
            <span class="lead-member__dot" aria-hidden="true"></span>
            {lead.role}
          </p>
          {isFilled(lead.name) && <h2 class="lead-member__name hl">{lead.name}</h2>}
          <p class="lead-member__cred">{lead.title ?? lead.credentials}</p>
          {lead.bio.map((para) => (
            <p class="lead-member__bio">{para}</p>
          ))}
        </div>
        {lead.highlights?.length && (
          <ul class="lead-member__highlights">
            {lead.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        )}
      </article>
    </div>
  </section>

  <section class="section-tight fill">
    <div class="wrap">
      <div class="reveal sec-head">
        <p class="eyebrow">At the chair</p>
        <h2 class="hl display-3">Who looks after you.</h2>
      </div>
      <ul class="team-grid reveal" data-shuffle>
        {rest.map((m) => (
          <li class="pmember" style={`--fam:${m.family}`}>
            <div class="pmember__portrait">
              {isFilled(m.photo) ? (
                <img src={m.photo} alt={isFilled(m.name) ? m.name : m.role} loading="lazy" />
              ) : (
                <span class="pmember__mono" aria-hidden="true">{m.monogram}</span>
              )}
            </div>
            <h3 class="pmember__name-lg">{isFilled(m.name) ? m.name : m.role}</h3>
            <p class="pmember__cred">{isFilled(m.name) ? m.role : m.credentials}</p>
            {m.bio?.map((para) => (
              <p class="pmember__bio">{para}</p>
            ))}
          </li>
        ))}
      </ul>
      <p class="team__note meta reveal">
        Our nurses administer every infusion and our lab technician handles
        bloodwork on site. Photographs are added as each team member joins the
        public page. Our physician is registered with the College of Physicians
        and Surgeons of Ontario; full registration details are shared on request
        and at your consult.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <RandomPullQuote accent="var(--accent-clinical)" />
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="reveal sec-head">
        <p class="eyebrow">How we work</p>
        <h2 class="hl display-3">One standard, every visit.</h2>
      </div>
      <div class="standards reveal">
        {standards.map((s) => (
          <article class="scard">
            <h3 class="scard__t">{s.t}</h3>
            <p class="scard__d">{s.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Meet us"
    heading="Care you can put a face to."
    body="Book a consult and meet the team. We will take the time to understand what you need before we suggest anything."
  />

  <script>
    // Shuffle the staff cards into a fresh order on every page load, so no one
    // is always listed first. Fisher–Yates, then re-append in the new order.
    const grid = document.querySelector('[data-shuffle]');
    if (grid) {
      const cards = Array.from(grid.children);
      for (let i = cards.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [cards[i], cards[j]] = [cards[j], cards[i]];
      }
      cards.forEach((c) => grid.appendChild(c));
    }
  </script>
</Layout>

<style>
  /* Featured physician — editorial split. */
  .lead-member {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(1.6rem, 5vw, 4rem);
    align-items: center;
  }
  /* With credential highlights, become photo | bio | highlights on wide screens. */
  .lead-member--3col {
    grid-template-columns: minmax(220px, 0.8fr) 1.5fr minmax(180px, 0.7fr);
    align-items: start;
  }
  .lead-member__portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 24%, color-mix(in oklab, var(--fam) 30%, transparent), transparent 68%),
      var(--cloud, #f1f0ec);
    border: 1px solid var(--line);
  }
  .lead-member__portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lead-member__mono {
    font-family: var(--display);
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 360;
    color: var(--fam);
    letter-spacing: 0.01em;
  }
  .lead-member__body {
    display: grid;
    gap: 0.5rem;
    align-content: center;
  }
  .lead-member__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.4rem;
  }
  .lead-member__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--fam);
    display: inline-block;
  }
  .lead-member__name {
    font-size: var(--step-3);
    line-height: 1.05;
  }
  .lead-member__cred {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fam);
    margin-bottom: 0.6rem;
  }
  .lead-member__bio {
    color: var(--graphite);
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: 52ch;
  }
  .lead-member__bio + .lead-member__bio {
    margin-top: 0.9rem;
  }
  /* In the 3-column layout the bio body is smaller, like the screenshot. */
  .lead-member--3col .lead-member__bio {
    font-size: var(--step-0);
    max-width: none;
  }
  .lead-member__highlights {
    list-style: none;
    padding: 1.4rem 0 0 1.4rem;
    margin: 0;
    border-left: 1px solid var(--line);
    display: grid;
    gap: 1rem;
    align-self: stretch;
  }
  .lead-member__highlights li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--ink);
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .lead-member__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fam);
  }

  .sec-head {
    display: grid;
    gap: 0.7rem;
    margin-bottom: var(--space-m);
  }

  /* The rest of the team — portrait cards. */
  .team-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 1.2rem;
  }
  .pmember {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem;
    display: grid;
    gap: 0.35rem;
    align-content: start;
    transition:
      border-color 0.35s var(--ease),
      transform 0.35s var(--ease);
  }
  .pmember:hover {
    border-color: var(--fam);
    transform: translateY(-3px);
  }
  .pmember__portrait {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius);
    overflow: hidden;
    display: grid;
    place-items: center;
    margin-bottom: 0.9rem;
    background:
      radial-gradient(circle at 32% 26%, color-mix(in oklab, var(--fam) 26%, transparent), transparent 70%),
      var(--cloud, #f1f0ec);
    border: 1px solid var(--line);
  }
  .pmember__portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pmember__mono {
    font-family: var(--display);
    font-size: var(--step-3);
    font-weight: 360;
    color: var(--fam);
  }
  .pmember__name-lg {
    font-family: var(--display);
    font-weight: 400;
    font-size: var(--step-1);
    line-height: 1.15;
    color: var(--ink);
  }
  .pmember__cred {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fam);
  }
  .pmember__bio {
    color: var(--graphite);
    font-size: var(--step--1);
    line-height: 1.6;
    margin-top: 0.35rem;
  }
  .team__note {
    margin-top: 1.6rem;
    max-width: 70ch;
    color: var(--mist);
  }

  .standards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }
  .scard {
    border-top: 1px solid var(--ink);
    padding-top: 1.1rem;
    display: grid;
    gap: 0.5rem;
  }
  .scard__t {
    font-size: var(--step-1);
  }
  .scard__d {
    color: var(--graphite);
    font-size: var(--step--1);
  }

  @media (max-width: 960px) {
    /* Highlights drop below the photo + bio, full width. */
    .lead-member--3col {
      grid-template-columns: 0.85fr 1.15fr;
      align-items: center;
    }
    .lead-member--3col .lead-member__highlights {
      grid-column: 1 / -1;
      border-left: 0;
      border-top: 1px solid var(--line);
      padding: 1.4rem 0 0 0;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.2rem;
    }
  }
  @media (max-width: 720px) {
    .lead-member,
    .lead-member--3col {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .lead-member__portrait {
      max-width: 320px;
    }
    .lead-member--3col .lead-member__highlights {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .standards {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
  }
  @media (max-width: 440px) {
    .team-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pmember {
      transition: none;
    }
  }
</style>
