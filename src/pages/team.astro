---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CtaBand from '@/components/CtaBand.astro';
import RandomPullQuote from '@/components/RandomPullQuote.astro';
import { team } from '@/data/team';
import { isFilled, locations } from '@/data/site';

const standards = [
  { t: 'Physician-reviewed', d: 'Every plan is reviewed by our physician before treatment — eligibility, dosing, and follow-up.' },
  { t: 'Nurse-administered', d: 'Registered nurses place every line and stay with you through the visit.' },
  { t: 'Screened first', d: 'We take a history and screen before we treat. If something is not right for you, we say so.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  name: 'Restoration Medical',
  description:
    'The physician-led care team behind Infusion Therapy at Restoration Medical, serving Thornhill and Maple.',
  url: Astro.site?.href,
  areaServed: locations.map((l) => l.name),
  employee: team.map((m) => ({
    '@type': 'Person',
    ...(isFilled(m.name) ? { name: m.name } : {}),
    jobTitle: m.role,
  })),
};
---

<Layout
  title="Our team"
  description="Meet the physician-led care team behind Infusion Therapy at Restoration Medical. A physician reviews, registered nurses administer, and every visit is screened first."
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="Our team · Refined by Medicine"
    accent="var(--accent-clinical)"
    lead="Infusion therapy here is delivered by people, not a counter. A physician reviews every plan; registered nurses give every treatment. Calm, careful, and accountable."
  >
    The people behind <span class="it">your care.</span>
  </PageHeader>

  <section class="section-tight">
    <div class="wrap">
      <div class="team reveal">
        {team.map((m) => (
          <article class="member" style={`--fam:${m.family}`}>
            <div class="member__avatar">
              {isFilled(m.photo) ? (
                <img src={m.photo} alt={isFilled(m.name) ? m.name : m.role} loading="lazy" />
              ) : (
                <span class="member__mono" aria-hidden="true">{m.monogram}</span>
              )}
            </div>
            <div class="member__body">
              <h2 class="member__role">{m.role}</h2>
              {isFilled(m.name) && <p class="member__name">{m.name}</p>}
              <p class="member__cred">{m.credentials}</p>
              <p class="member__bio">{m.bio}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="team__note meta reveal">
        Individual names and photographs are added as each team member joins the
        public page. Our physician is registered with the College of Physicians
        and Surgeons of Ontario; full registration details are shared on request
        and at your consult.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <RandomPullQuote accent="var(--accent-clinical)" />
    </div>
  </section>

  <section class="section-tight fill">
    <div class="wrap">
      <div class="reveal sec-head">
        <p class="eyebrow">How we work</p>
        <h2 class="hl display-3">One standard, every visit.</h2>
      </div>
      <div class="standards reveal">
        {standards.map((s) => (
          <article class="scard">
            <h3 class="scard__t">{s.t}</h3>
            <p class="scard__d">{s.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Meet us"
    heading="Care you can put a face to."
    body="Book a consult and meet the team. We will take the time to understand what you need before we suggest anything."
  />
</Layout>

<style>
  .team {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }
  .member {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.8rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.4rem;
    align-items: start;
    transition:
      border-color 0.35s var(--ease),
      transform 0.35s var(--ease);
  }
  .member:hover {
    border-color: var(--fam);
    transform: translateY(-3px);
  }
  .member__avatar {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 32% 28%, color-mix(in oklab, var(--fam) 26%, transparent), transparent 70%),
      var(--cloud, #f1f0ec);
    border: 1px solid var(--line);
  }
  .member__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .member__mono {
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--fam);
  }
  .member__body {
    display: grid;
    gap: 0.35rem;
  }
  .member__role {
    font-size: var(--step-1);
    line-height: 1.15;
  }
  .member__name {
    font-family: var(--display);
    font-size: var(--step-1);
    color: var(--ink);
  }
  .member__cred {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fam);
  }
  .member__bio {
    color: var(--graphite);
    font-size: var(--step--1);
    line-height: 1.6;
    margin-top: 0.35rem;
  }
  .team__note {
    margin-top: 1.6rem;
    max-width: 70ch;
    color: var(--mist);
  }
  .sec-head {
    display: grid;
    gap: 0.7rem;
    margin-bottom: var(--space-m);
  }
  .standards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }
  .scard {
    border-top: 1px solid var(--ink);
    padding-top: 1.1rem;
    display: grid;
    gap: 0.5rem;
  }
  .scard__t {
    font-size: var(--step-1);
  }
  .scard__d {
    color: var(--graphite);
    font-size: var(--step--1);
  }
  @media (max-width: 820px) {
    .team,
    .standards {
      grid-template-columns: 1fr;
    }
    .standards {
      gap: 1.4rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .member {
      transition: none;
    }
  }
</style>
