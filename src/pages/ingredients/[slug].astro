---
import Layout from '@/layouts/Layout.astro';
import CtaBand from '@/components/CtaBand.astro';
import IvDisclaimer from '@/components/IvDisclaimer.astro';
import TreatmentCard from '@/components/TreatmentCard.astro';
import { ingredients, ingredientBySlug, ingredientEvidence } from '@/data/ingredients';
import { treatmentsWithIngredient } from '@/data/treatments';
import { families } from '@/data/families';

export function getStaticPaths() {
  return ingredients.map((i) => ({ params: { slug: i.slug } }));
}

const { slug } = Astro.params;
const ingredient = ingredientBySlug(slug!)!;
const fam = families[ingredient.family];
const foundIn = treatmentsWithIngredient(ingredient.slug);
const evidence = ingredientEvidence(ingredient.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: ingredient.name,
  description: ingredient.whatItIs,
  url: new URL(`/ingredients/${ingredient.slug}`, Astro.site).href,
};
---

<Layout
  title={ingredient.name}
  description={`${ingredient.name}: ${ingredient.oneLine} What it is, what it may support, and the treatments it appears in at Restoration Medical. Honest about evidence.`}
  jsonLd={jsonLd}
>
  <header
    class="ih reveal"
    style={`--accent: var(--accent-${ingredient.family}); --accent-text: ${fam.text}`}
  >
    <div class="wrap ih__wrap">
      <div class="ih__text">
        <a class="link-arrow ih__back" href="/ingredients">&larr; Ingredient library</a>
        <div class="ih__meta">
          <span class="eyebrow ih__eyebrow">
            <span class="ih__dot" aria-hidden="true"></span>
            {ingredient.role}
          </span>
          <span
            class={`ev ev--${evidence.level === 'Established' ? 'est' : 'emg'}`}
            title={evidence.note}
          >
            <span class="ev__dot" aria-hidden="true"></span>
            {evidence.level} evidence
          </span>
        </div>
        <h1 class="hl ih__title display-2">{ingredient.name}</h1>
        <p class="lead ih__line">{ingredient.oneLine}</p>
      </div>
      <div class="ih__specimen" aria-hidden="true">
        <canvas class="ih__swatch" data-ing-swatch></canvas>
      </div>
    </div>
  </header>

  <section class="section-tight">
    <div class="wrap-narrow stack-lg">
      <div class="reveal block">
        <h2 class="block__h">What it is</h2>
        <p class="block__p">{ingredient.whatItIs}</p>
      </div>

      <div class="reveal block">
        <h2 class="block__h">What it may support</h2>
        <ul class="supports">
          {ingredient.maySupport.map((s) => (
            <li class="supports__item">
              <span class="supports__tick" aria-hidden="true"></span>{s}
            </li>
          ))}
        </ul>
      </div>

      {ingredient.goodToKnow && (
        <div class="reveal block block--note">
          <h2 class="block__h">Good to know</h2>
          <p class="block__p">{ingredient.goodToKnow}</p>
        </div>
      )}
    </div>
  </section>

  {foundIn.length > 0 && (
    <section class="section-tight fill">
      <div class="wrap">
        <div class="reveal sec-head">
          <p class="eyebrow">Found in these treatments</p>
          <h2 class="hl display-3">Where you will meet it.</h2>
        </div>
        <div class="grid reveal">
          {foundIn.map((t) => <TreatmentCard treatment={t} />)}
        </div>
      </div>
    </section>
  )}

  {ingredient.slug !== 'iron-sucrose' && (
    <section class="section-tight">
      <div class="wrap-narrow">
        <IvDisclaimer class="reveal" />
      </div>
    </section>
  )}

  <CtaBand />
</Layout>

<style>
  .ih {
    padding-top: var(--space-l);
    padding-bottom: var(--space-m);
    border-bottom: 1px solid var(--line);
    /* A slight wash of the ingredient's accent rising up from the line. */
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--accent) 13%, transparent),
      transparent 60%
    );
  }
  .ih__wrap {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
    align-items: center;
  }
  .ih__text {
    max-width: 56ch;
  }
  .ih__back {
    display: inline-block;
    margin-bottom: 2rem;
    border-color: transparent;
  }
  .ih__meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }
  .ih__eyebrow {
    color: var(--accent-text);
    margin-bottom: 0;
  }
  /* Honest evidence tag: established (solid) vs emerging (hollow). */
  .ev {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--graphite);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.26rem 0.62rem;
    cursor: help;
  }
  .ev__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .ev--est .ev__dot {
    background: var(--accent-metabolic);
  }
  .ev--emg .ev__dot {
    background: transparent;
    border: 1.5px solid var(--mist);
  }
  .ih__specimen {
    justify-self: end;
  }
  .ih__swatch {
    display: block;
    width: clamp(112px, 13vw, 156px);
    height: clamp(112px, 13vw, 156px);
    border-radius: 50%;
    border: 1px solid var(--line);
    /* The canvas reads this resolved colour for the diffusion. */
    color: var(--accent);
    background: var(--white-pure);
  }
  @media (max-width: 720px) {
    .ih__wrap {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }
    .ih__specimen {
      justify-self: start;
      order: -1;
    }
  }
  .ih__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }
  .ih__line {
    margin-top: 1.4rem;
  }
  .stack-lg {
    display: grid;
    gap: var(--space-m);
  }
  .block__h {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }
  .block__p {
    color: var(--graphite);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .block--note {
    border-top: 1px solid var(--line);
    padding-top: var(--space-m);
  }
  .block--note .block__p {
    font-size: var(--step-0);
  }
  .supports {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  .supports__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.8rem;
    align-items: baseline;
    color: var(--graphite);
    font-size: var(--step-1);
  }
  .supports__tick {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-2px);
  }
  .sec-head {
    display: grid;
    gap: 0.7rem;
    margin-bottom: var(--space-m);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.2rem;
  }
</style>

<script>
  // Ingredient "specimen": a slow single-colour diffusion of the ingredient's
  // own accent, blooming inside the circular swatch.
  const initSwatch = () => {
    const canvas = document.querySelector('[data-ing-swatch]');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const color = getComputedStyle(canvas).color || '#888';
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    let w = 0, h = 0, raf = 0, frame = 0;
    const drops: any[] = [];

    const resize = () => {
      const r = canvas.getBoundingClientRect();
      w = r.width; h = r.height;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.round(w * dpr));
      canvas.height = Math.max(1, Math.round(h * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const spawn = () => {
      drops.push({
        x: w * rand(0.28, 0.72),
        y: h * rand(0.55, 0.9),
        r: rand(w * 0.07, w * 0.15),
        grow: rand(0.02, 0.05),
        life: 0,
        ttl: rand(170, 280),
      });
    };
    const paint = (d: any, a: number) => {
      const g = ctx.createRadialGradient(d.x, d.y, 0, d.x, d.y, d.r);
      g.addColorStop(0, color);
      g.addColorStop(1, 'transparent');
      ctx.globalAlpha = a;
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
      ctx.fill();
    };
    const tick = () => {
      if (!canvas.isConnected) { raf = 0; return; }
      ctx.clearRect(0, 0, w, h);
      for (let i = drops.length - 1; i >= 0; i--) {
        const d = drops[i];
        d.life++;
        d.y -= 0.16;
        d.r += d.grow;
        const t = d.life / d.ttl;
        const f = Math.sin(Math.min(t, 1) * Math.PI);
        paint(d, Math.max(0, f) * 0.42);
        if (t >= 1) drops.splice(i, 1);
      }
      ctx.globalAlpha = 1;
      if (frame % 28 === 0 && drops.length < 6) spawn();
      frame++;
      raf = requestAnimationFrame(tick);
    };

    resize();
    window.addEventListener('resize', resize);
    if (reduce) {
      spawn(); spawn();
      drops.forEach((d) => paint(d, 0.35));
      ctx.globalAlpha = 1;
      return;
    }
    for (let i = 0; i < 3; i++) { spawn(); drops[drops.length - 1].life = i * 60; }
    raf = requestAnimationFrame(tick);
  };

  if (document.readyState !== 'loading') initSwatch();
  else document.addEventListener('DOMContentLoaded', initSwatch);
</script>
