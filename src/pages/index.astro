---
import Layout from '@/layouts/Layout.astro';
import TreatmentCard from '@/components/TreatmentCard.astro';
import ConcernTile from '@/components/ConcernTile.astro';
import CtaBand from '@/components/CtaBand.astro';
import GoogleRating from '@/components/GoogleRating.astro';
import RandomPullQuote from '@/components/RandomPullQuote.astro';
import { treatmentBySlug, type Treatment } from '@/data/treatments';
import { concerns } from '@/data/concerns';
import { site, locations } from '@/data/site';
import { honestMenu } from '@/data/honestMenu';

// Three honest-menu items for the no-JS fallback (build-time pick); the client
// re-rolls a fresh three on every visit.
const honestPicks = [...honestMenu]
  .sort(() => Math.random() - 0.5)
  .slice(0, 3);

// Home teaser: the eight highest-priced drips (price estimated from
// ingredients and infusion length, since the site shows no pricing), then
// ordered by estimated popularity within that set. Tune both with real
// price and booking data. The full set lives on /drips.
// Estimated price rank (high to low): nad-longevity, beauty-elixir,
// pregnancy-care, metabolic, radiance, kingmaker, immune-shield, healing,
// then recover, hair-nails, foundation, revive.
const featuredSlugs = [
  'healing',
  'radiance',
  'immune-shield',
  'nad-longevity',
  'beauty-elixir',
  'metabolic',
  'kingmaker',
  'pregnancy-care',
];
const featuredDrips = featuredSlugs
  .map((s) => treatmentBySlug(s))
  .filter((t): t is Treatment => Boolean(t));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: site.fullName,
  description: site.description,
  medicalSpecialty: 'PreventiveMedicine',
  url: Astro.site?.href,
  email: site.email,
  areaServed: locations.map((l) => l.name),
};

const steps = [
  {
    n: '01',
    t: 'Consult & screen',
    d: 'We talk through how you want to feel and review your health, so any treatment is safe and right for you.',
  },
  {
    n: '02',
    t: 'Personalize your treatment',
    d: 'Our physician reviews and our nurse tailors the drip or shot to you. No fixed menu, no pressure.',
  },
  {
    n: '03',
    t: 'Relax while we care for you',
    d: 'Settle into the chair in a calm clinical setting. We stay with you from the first drop to the last.',
  },
];
---

<Layout title="home" jsonLd={jsonLd}>
  <!-- Hero: thesis, black and white — the colour lives inside the letters -->
  <section class="hero" data-hero>
    <!-- Living IV bag: a real-time fluid the pointer can stir -->
    <div class="hero__bag" aria-hidden="true">
      <div class="hero__bag-body" data-bag-body>
        <canvas class="hero__bag-canvas" data-hero-fluid></canvas>
      </div>
      <svg class="hero__bag-frame" viewBox="0 0 128 184" fill="none" aria-hidden="true">
        <!-- Back face: the same silhouette offset behind, suggesting the
             bag's thickness while staying pure line-art. -->
        <path
          class="hero__bag-outline hero__bag-outline--back"
          pathLength="1"
          transform="translate(3.5 3)"
          d="M24 8 L104 8 Q120 8 120 24 L120 108 Q120 118 111 121 L72 134 L72 146 L56 146 L56 134 L17 121 Q8 118 8 108 L8 24 Q8 8 24 8 Z"
        />
        <!-- Bag silhouette: rounded body tapering to a centre funnel -->
        <path
          class="hero__bag-outline"
          pathLength="1"
          d="M24 8 L104 8 Q120 8 120 24 L120 108 Q120 118 111 121 L72 134 L72 146 L56 146 L56 134 L17 121 Q8 118 8 108 L8 24 Q8 8 24 8 Z"
        />
        <!-- Luer connector below the funnel -->
        <rect class="hero__bag-outline" pathLength="1" x="51" y="146" width="26" height="12" rx="3" />
        <path class="hero__bag-outline" pathLength="1" d="M58 158 L70 158 L66.5 178 L61.5 178 Z" />
        <!-- Hanging slot -->
        <rect class="hero__bag-hole" x="47" y="17" width="34" height="11" rx="5.5" />
        <!-- Side ports -->
        <ellipse class="hero__bag-port" cx="105" cy="46" rx="3.6" ry="6.2" />
        <ellipse class="hero__bag-port" cx="105" cy="62" rx="3.6" ry="6.2" />
      </svg>
    </div>
    <div class="wrap hero__inner">
      <p class="eyebrow hero__eyebrow in-load">
        Infusion Therapy · Refined by Medicine
      </p>
      <!-- Arrival states: how people actually show up, dissolving like ink
           until it settles. Static final line for no-JS and reduced motion. -->
      <p class="hero__arrive in-load" style="--load-delay: 40ms">
        <span class="visually-hidden">However you arrive.</span>
        <span class="hero__arrive-w" data-arrive aria-hidden="true">However you arrive.</span>
      </p>
      <!-- Liquid typography: real text with the drifting brand gradient
           clipped to the letters (background-clip: text). No opaque plate,
           so there is nothing to mismatch the page in light or dark. -->
      <h1 class="hl hero__title hero__title--fluid">
        <span class="lg">Come as you are.</span>
        <span class="lg it">Leave feeling restored.</span>
      </h1>
      <p class="lead hero__lead in-load" style="--load-delay: 180ms">
        From everyday energy to clinically indicated iron infusions, our
        therapies meet your body where it is and help you feel like yourself
        again. Reviewed by our physician, given by our nurses.
      </p>
      <div class="hero__actions in-load" style="--load-delay: 260ms">
        <a class="btn btn--lg" href="/book">Book a consult</a>
        <a class="link-arrow" href="/drips">Explore drips &amp; shots &rarr;</a>
      </div>
    </div>
    <div class="wrap hero__meta in-load" style="--load-delay: 340ms">
      <span class="meta">Physician-reviewed</span>
      <span class="hero__sep" aria-hidden="true"></span>
      <span class="meta">Nurse-administered</span>
      <span class="hero__sep" aria-hidden="true"></span>
      <span class="meta">Thornhill &amp; Maple (Coming Soon)</span>
    </div>
  </section>

  <!-- A single drop detaches from the bag and rides the scroll down the page,
       landing in the closing band as a ripple. Desktop, motion-safe only. -->
  <div class="scroll-drop" data-scroll-drop aria-hidden="true">
    <svg viewBox="0 0 24 32" fill="currentColor">
      <path d="M12 2C12 2 4 13.5 4 20a8 8 0 0 0 16 0C20 13.5 12 2 12 2Z" />
    </svg>
  </div>

  <!-- Two paths, one standard of care -->
  <section class="section fill">
    <div class="wrap">
      <div class="reveal sec-head">
        <p class="eyebrow">Two paths, one standard of care</p>
        <h2 class="hl display-3">
          Wellness <span class="it">and</span> clinical, under one roof.
        </h2>
      </div>
      <div class="paths reveal">
        <article class="path">
          <h3 class="path__title">Wellness infusions &amp; shots</h3>
          <p class="path__body">
            Support energy, immunity, skin, recovery, and healthy aging.
            Personalized to you, given in a calm clinical setting. Elective,
            and designed around how you want to feel.
          </p>
          <a class="link-arrow" href="/drips">Browse drips &amp; shots &rarr;</a>
        </article>
        <article class="path">
          <h3 class="path__title">Clinical infusions</h3>
          <p class="path__body">
            Including iron therapy for low ferritin and iron deficiency.
            Lab-reviewed and physician-directed, for when your body needs more
            than supplements can give.
          </p>
          <a class="link-arrow" href="/iron-therapy">See iron therapy &rarr;</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Find your starting point -->
  <section class="section">
    <div class="wrap">
      <div class="reveal sec-head">
        <p class="eyebrow">Find your starting point</p>
        <h2 class="hl display-3">Start with how you feel.</h2>
        <p class="lead">
          Tell us how you want to feel. We will help you find the right
          support. Most people arrive with a feeling, not a product name.
        </p>
      </div>
      <div class="concern-grid reveal">
        {concerns.map((c) => <ConcernTile concern={c} />)}
      </div>
    </div>
  </section>

  <!-- The mega-menu surfaced: the colour payoff -->
  <section class="section fill">
    <div class="wrap">
      <div class="reveal sec-head">
        <p class="eyebrow">Browse our drips &amp; shots</p>
        <h2 class="hl display-3">
          The page is quiet. <span class="it">The menu blooms.</span>
        </h2>
        <p class="lead">
          Each treatment family carries its own accent, drawn from its
          ingredients. A considered apothecary, not a rainbow.
        </p>
      </div>
      <div class="drip-grid reveal">
        {featuredDrips.map((t) => <TreatmentCard treatment={t} />)}
      </div>
      <div class="reveal more-row">
        <a class="btn btn--ghost" href="/drips">See all drips</a>
        <a class="link-arrow" href="/shots">Visit the Injection Bar &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Editorial beat: a random on-brand line per visit -->
  <section class="section-tight">
    <div class="wrap">
      <RandomPullQuote accent="var(--accent-recovery)" />
    </div>
  </section>

  <hr class="beat" />

  <!-- Why physician-led -->
  <section class="section">
    <div class="wrap trust">
      <div class="reveal trust__intro">
        <p class="eyebrow">Why physician-led matters</p>
        <h2 class="hl display-3">
          A real clinic, <span class="it">not a drip bar.</span>
        </h2>
        <p class="lead">
          The difference is quiet but it is everything. Screening, real medical
          oversight, and nurses who do this every day.
        </p>
      </div>
      <ul class="trust__list reveal">
        <li>
          <p class="trust__h">Physician oversight</p>
          <p class="trust__d">Every treatment is reviewed by our physician, not sold from a counter.</p>
        </li>
        <li>
          <p class="trust__h">RN administration</p>
          <p class="trust__d">Your infusion is placed and monitored by a registered nurse.</p>
        </li>
        <li>
          <p class="trust__h">Honest screening</p>
          <p class="trust__d">We screen first, and we will adjust or decline on clinical grounds.</p>
        </li>
        <li>
          <p class="trust__h">Sourcing standards</p>
          <p class="trust__d">Pharmaceutical-grade ingredients, prepared to clinical standards.</p>
        </li>
      </ul>
    </div>
  </section>

  <hr class="beat" />

  <!-- The honest menu: overclaims struck through and rewritten, live -->
  <section class="section">
    <div class="wrap">
      <div class="reveal sec-head">
        <p class="eyebrow">The honest menu</p>
        <h2 class="hl display-3">
          What a drip bar promises. <span class="it">What we say.</span>
        </h2>
      </div>
      <ul class="honest reveal" data-honest>
        {honestPicks.map((item) => (
          <li class="honest__row">
            <p class="honest__hype">
              &ldquo;{item.hype}&rdquo;
              <span class="honest__strike" aria-hidden="true"></span>
            </p>
            <p class="honest__truth">{item.truth}</p>
          </li>
        ))}
      </ul>
      <p class="honest__note meta reveal">
        Where the evidence is still developing, we label it Emerging &mdash;
        right on the ingredient. Results vary from person to person, and we
        screen first.
      </p>
    </div>
  </section>

  <!-- How it works -->
  <section class="section fill">
    <div class="wrap">
      <div class="reveal sec-head">
        <p class="eyebrow">How it works</p>
        <h2 class="hl display-3">Three quiet steps.</h2>
      </div>
      <ol class="steps reveal">
        {steps.map((s) => (
          <li class="step">
            <span class="step__n meta tnum">{s.n}</span>
            <h3 class="step__t">{s.t}</h3>
            <p class="step__d">{s.d}</p>
          </li>
        ))}
      </ol>
      <div class="reveal more-row">
        <a class="link-arrow" href="/how-it-works">Read what to expect &rarr;</a>
      </div>
    </div>
  </section>

  <GoogleRating />

  <CtaBand
    eyebrow="Begin"
    heading="Care that begins with you."
    body="Wellness or clinical, the standard of care is the same. A consult confirms what is right for you. No pricing surprises, no pressure."
  />
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vh, 7rem) var(--space-l);
  }
  .hero__inner,
  .hero__meta {
    position: relative;
    z-index: 2;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Liquid typography ──────────────────────────────────────────────
     The headline is a paper-coloured plate with the words knocked out of
     it; moving liquid shows through the letterforms. Until the filmed
     loop exists, an animated liquid gradient carries the effect. */
  .hero__title {
    font-size: var(--step-5);
    max-width: 16ch;
  }
  /* "Come as you are." is the quiet setup; "Leave feeling restored." is the
     emphasised payoff - italic at the richest loaded weight. */
  .hero__title .lg:first-child {
    font-weight: 340;
  }
  .hero__title .it {
    font-weight: 440;
  }
  /* Clip the drifting brand gradient to the real letters. Fallback is solid
     ink text where background-clip:text is unsupported. */
  .hero__title--fluid {
    color: var(--ink);
  }
  @supports (
      (-webkit-background-clip: text) or (background-clip: text)
    ) {
    .hero__title--fluid {
      background: linear-gradient(
        115deg,
        #3e5c6e,
        #4f7c82 20%,
        #b98aae 42%,
        #c65f73 58%,
        #c2703d 74%,
        #3e4c8a 100%
      );
      background-size: 280% 280%;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
      animation:
        inLoad 0.8s var(--ease) both 0.09s,
        hero-gradient-drift 22s ease-in-out infinite alternate;
    }
  }
  @keyframes hero-gradient-drift {
    from {
      background-position: 0% 30%;
    }
    to {
      background-position: 100% 70%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__title--fluid {
      animation: none;
    }
  }

  /* ── The IV bag: line-art frame around a real-time fluid ──────────── */
  /* 2.5D: --nx/--ny (-1..1, set by JS from the pointer) lean the whole bag,
     shift the plastic sheen, and stretch the ground shadow. */
  .hero__bag {
    position: absolute;
    z-index: 1;
    top: 50%;
    right: clamp(0.5rem, 5vw, 5rem);
    transform: translateY(-50%) perspective(950px)
      rotateY(calc(var(--nx, 0) * 6deg)) rotateX(calc(var(--ny, 0) * -3.5deg));
    width: clamp(196px, 22vw, 280px);
    aspect-ratio: 128 / 184;
    pointer-events: none;
    will-change: transform;
  }
  /* Grounding shadow: a soft pool under the bag that answers the tilt. */
  .hero__bag::before {
    content: '';
    position: absolute;
    left: 16%;
    right: 16%;
    bottom: -3.5%;
    height: 11px;
    border-radius: 50%;
    background: radial-gradient(
      50% 50% at 50% 50%,
      rgba(26, 27, 29, 0.16),
      transparent 72%
    );
    filter: blur(3px);
    transform: translateX(calc(var(--nx, 0) * -12px))
      scaleX(calc(1 + var(--ny, 0) * 0.07));
    opacity: 0;
    animation: hero-fade-in 0.6s var(--ease) forwards 1.2s;
  }
  :global([data-theme='dark']) .hero__bag::before {
    background: radial-gradient(
      50% 50% at 50% 50%,
      rgba(0, 0, 0, 0.55),
      transparent 72%
    );
  }
  .hero__bag-outline--back {
    opacity: 0.28;
    stroke-width: 1.2;
    animation-delay: 0.35s;
  }
  /* Liquid depth: darker toward the walls and floor, so the fluid reads as
     a volume behind the outline rather than a flat wash. */
  .hero__bag-body::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    border-radius: inherit;
    box-shadow:
      inset 0 -16px 22px -14px rgba(26, 27, 29, 0.22),
      inset 10px 0 16px -12px rgba(26, 27, 29, 0.12),
      inset -10px 0 16px -12px rgba(26, 27, 29, 0.12),
      inset 0 10px 14px -12px rgba(26, 27, 29, 0.08);
  }
  /* Plastic sheen: one curved highlight that slides against the tilt. */
  .hero__bag-body::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    border-radius: inherit;
    background:
      radial-gradient(
        130% 55% at calc(32% + var(--nx, 0) * -16%) 15%,
        rgba(255, 255, 255, 0.4),
        transparent 55%
      ),
      linear-gradient(
        100deg,
        transparent 32%,
        rgba(255, 255, 255, 0.14) 45%,
        transparent 58%
      );
    mix-blend-mode: screen;
  }
  :global([data-theme='dark']) .hero__bag-body::after {
    opacity: 0.5;
  }
  /* The liquid answers the pointer: stir it, or click to drop an ingredient. */
  .hero__bag-body {
    pointer-events: auto;
    touch-action: pan-y;
  }
  /* Entrance: the bag draws itself, then the liquid pours in. */
  .hero__bag-outline {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hero-draw 1.2s var(--ease) forwards 0.15s;
  }
  .hero__bag-hole,
  .hero__bag-port {
    opacity: 0;
    animation: hero-fade-in 0.6s var(--ease) forwards 1.05s;
  }
  .hero__bag-body {
    opacity: 0;
    animation: hero-pour 0.9s var(--ease) forwards 1.15s;
  }
  @keyframes hero-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes hero-fade-in {
    to {
      opacity: 1;
    }
  }
  @keyframes hero-pour {
    from {
      opacity: 0;
      transform: translateY(5%);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* Scrolling skips the overture: everything jumps to its settled state.
     (The ambient gradient drift is untouched — only entrance animations.) */
  .hero--skip .hero__bag-outline,
  .hero--skip .hero__bag-hole,
  .hero--skip .hero__bag-port,
  .hero--skip .hero__bag-body,
  .hero--skip .in-load {
    animation-duration: 0.01ms !important;
    animation-delay: 0ms !important;
  }
  /* The title's gradient drift must keep running when the overture is
     skipped, so null only its entrance delay, not its animation duration. */
  .hero--skip .hero__title--fluid {
    animation-delay: 0ms, 0s !important;
  }

  /* ── The travelling drop (scroll narrative) ─────────────────────────── */
  .scroll-drop {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 3;
    width: 15px;
    color: var(--accent-recovery);
    opacity: 0;
    pointer-events: none;
    will-change: transform;
    transition: opacity 0.4s var(--ease);
    filter: drop-shadow(0 1px 2px color-mix(in srgb, var(--accent-recovery) 35%, transparent));
  }
  :global(.drop-ripple) {
    position: fixed;
    z-index: 3;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    pointer-events: none;
    border-radius: 50%;
    border: 1.5px solid var(--accent-recovery);
    animation: drop-ripple 0.9s var(--ease) forwards;
  }
  :global(.drop-ripple--late) {
    animation-delay: 0.18s;
    opacity: 0;
  }
  @keyframes drop-ripple {
    0% {
      opacity: 0.9;
      transform: scale(0.4);
    }
    100% {
      opacity: 0;
      transform: scale(7);
    }
  }
  /* Liquid chamber: sits inside the straight-sided body of the silhouette,
     a touch in from the walls so the outline frames it. */
  .hero__bag-body {
    position: absolute;
    top: 7.5%;
    bottom: 39%;
    left: 11%;
    right: 11%;
    border-radius: 13px 13px 10px 10px;
    background: color-mix(in srgb, var(--cloud) 50%, transparent);
    overflow: hidden;
  }
  .hero__bag-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mix-blend-mode: multiply;
    -webkit-mask-image: linear-gradient(to top, #000 0 80%, transparent 100%);
    mask-image: linear-gradient(to top, #000 0 80%, transparent 100%);
  }
  .hero__bag-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hero__bag-outline {
    fill: none;
    stroke: color-mix(in srgb, var(--graphite) 38%, var(--line));
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .hero__bag-hole {
    fill: var(--paper);
    stroke: color-mix(in srgb, var(--graphite) 38%, var(--line));
    stroke-width: 1.5;
  }
  .hero__bag-port {
    fill: color-mix(in srgb, var(--accent-recovery) 70%, var(--paper));
  }
  @media (min-width: 1000px) {
    .hero__inner,
    .hero__meta {
      padding-right: clamp(270px, 27vw, 380px);
    }
  }
  @media (max-width: 999px) {
    /* On small screens the bag sits low, behind the actions and meta rows,
       so the headline plate never cuts across it. */
    .hero__bag {
      top: auto;
      bottom: -4%;
      transform: none;
      right: clamp(-70px, -4vw, -20px);
      opacity: 0.28 !important;
      width: clamp(190px, 40vw, 260px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__bag {
      transition: none;
    }
  }
  .hero__eyebrow {
    margin-bottom: 2rem;
  }
  /* Arrival states line */
  .hero__arrive {
    margin: -0.8rem 0 1.6rem;
  }
  .hero__arrive-w {
    display: inline-block;
    font-family: var(--display);
    font-style: italic;
    font-weight: 340;
    font-size: var(--step-1);
    color: var(--mist);
    transition:
      opacity 0.42s var(--ease),
      filter 0.42s var(--ease),
      transform 0.42s var(--ease);
  }
  .hero__arrive-w.is-out {
    opacity: 0;
    filter: blur(7px);
    transform: translateY(-5px);
  }

  .hero__lead {
    margin-top: 2rem;
    font-size: var(--step-1);
  }
  .hero__actions {
    margin-top: 2.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .hero__meta {
    margin-top: 3.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .hero__sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--line);
  }

  .sec-head {
    max-width: 60ch;
    margin-bottom: var(--space-m);
    display: grid;
    gap: 1rem;
  }

  /* Section divider: a hairline at the seam between two sections that both
     sit on paper (with no fill band to separate them). */
  .beat {
    border: 0;
    height: 1px;
    width: min(100% - 2.5rem, 1180px);
    margin: 0 auto;
    background: color-mix(in srgb, var(--graphite) 20%, var(--line));
  }

  .paths {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .path {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2.2rem 2rem;
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .path__title {
    font-size: var(--step-2);
  }
  .path__body {
    color: var(--graphite);
  }

  .concern-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }
  .drip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.2rem;
  }
  .more-row {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .trust {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 3rem;
    align-items: start;
  }
  .trust__intro {
    display: grid;
    gap: 1rem;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  .trust__list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
  }
  .trust__h {
    font-family: var(--display);
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  .trust__d {
    color: var(--graphite);
    font-size: var(--step--1);
  }

  /* The honest menu: overclaim struck through, honest line settles in. */
  .honest {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 62rem;
  }
  .honest__row {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 0.8rem 3rem;
    align-items: baseline;
    border-top: 1px solid var(--line);
    padding-block: 1.6rem;
  }
  .honest__hype {
    position: relative;
    justify-self: start;
    font-family: var(--display);
    font-style: italic;
    font-weight: 340;
    font-size: var(--step-2);
    color: var(--mist);
    line-height: 1.2;
  }
  .honest__strike {
    position: absolute;
    left: -1.5%;
    right: -1.5%;
    top: 55%;
    height: 2px;
    background: var(--accent-clinical);
    transform-origin: left center;
  }
  .honest__truth {
    color: var(--graphite);
    line-height: 1.6;
  }
  .honest__note {
    margin-top: 1.4rem;
    color: var(--mist);
  }
  /* Armed by JS (motion-safe only): strikes draw, truths settle, staggered. */
  .honest[data-armed] .honest__strike {
    transform: scaleX(0);
    transition: transform 0.55s var(--ease);
  }
  .honest[data-armed] .honest__truth {
    opacity: 0;
    transform: translateY(9px);
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease);
  }
  .honest.honest--go .honest__strike {
    transform: scaleX(1);
  }
  .honest.honest--go .honest__truth {
    opacity: 1;
    transform: none;
  }
  .honest--go .honest__row:nth-child(1) .honest__strike { transition-delay: 0.1s; }
  .honest--go .honest__row:nth-child(1) .honest__truth { transition-delay: 0.5s; }
  .honest--go .honest__row:nth-child(2) .honest__strike { transition-delay: 0.65s; }
  .honest--go .honest__row:nth-child(2) .honest__truth { transition-delay: 1.05s; }
  .honest--go .honest__row:nth-child(3) .honest__strike { transition-delay: 1.2s; }
  .honest--go .honest__row:nth-child(3) .honest__truth { transition-delay: 1.6s; }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    counter-reset: step;
  }
  .step {
    border-top: 1px solid var(--ink);
    padding-top: 1.2rem;
    display: grid;
    gap: 0.7rem;
  }
  .step__t {
    font-size: var(--step-2);
  }
  .step__d {
    color: var(--graphite);
  }

  @media (max-width: 820px) {
    .paths,
    .trust,
    .trust__list,
    .steps,
    .honest__row {
      grid-template-columns: 1fr;
    }
    .trust__intro {
      position: static;
    }
  }
</style>

<script>
  import { initHeroFluidGL } from '../scripts/hero-fluid-gl';
  import { honestMenu } from '../data/honestMenu';

  // Ingredient palette: the family + base accents, the colours added to a drip.
  const palette = [
    "#3e5c6e", "#b98aae", "#c2703d", "#c9a227", "#6e8b5a",
    "#4f7c82", "#0e9bc9", "#c65f73", "#3e4c8a",
  ];
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  interface Drop {
    x: number; y: number; vy: number; drift: number; phase: number;
    r: number; grow: number; life: number; ttl: number; color: string;
  }

  // 2D fallback: the original soft-bloom liquid, used when WebGL2/float
  // buffers are unavailable or motion is reduced.
  const initHeroFluid2D = (canvas: HTMLCanvasElement) => {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    let w = 0, h = 0, raf = 0, frame = 0, baseT = Math.random() * 9;
    const drops: Drop[] = [];

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      w = rect.width; h = rect.height;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.round(w * dpr));
      canvas.height = Math.max(1, Math.round(h * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const spawn = () => {
      drops.push({
        x: w * rand(0.18, 0.82),
        y: h + 10,
        vy: -rand(0.03, 0.09),
        drift: rand(-0.5, 0.5),
        phase: rand(0, Math.PI * 2),
        r: rand(w * 0.1, w * 0.17),
        grow: rand(0.02, 0.05),
        life: 0,
        ttl: rand(900, 1400),
        color: palette[Math.floor(Math.random() * palette.length)],
      });
    };

    const paint = (d: Pick<Drop, 'x' | 'y' | 'r' | 'color'>, alpha: number) => {
      const g = ctx.createRadialGradient(d.x, d.y, 0, d.x, d.y, d.r);
      g.addColorStop(0, d.color);
      g.addColorStop(1, "rgba(255,255,255,0)");
      ctx.globalAlpha = alpha;
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
      ctx.fill();
    };

    // The settled fluid the bag is filled with: a soft tint rising from the
    // bottom, its hue drifting slowly as new ingredients blend in.
    const paintBase = () => {
      baseT += 0.0009;
      const i = Math.floor(baseT) % palette.length;
      const mix = baseT % 1;
      const g = ctx.createLinearGradient(0, h, 0, h * 0.18);
      g.addColorStop(0, palette[i]);
      g.addColorStop(1, "rgba(255,255,255,0)");
      ctx.globalAlpha = 0.14;
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, w, h);
      const g2 = ctx.createLinearGradient(0, h, 0, h * 0.32);
      g2.addColorStop(0, palette[(i + 1) % palette.length]);
      g2.addColorStop(1, "rgba(255,255,255,0)");
      ctx.globalAlpha = 0.1 * mix;
      ctx.fillStyle = g2;
      ctx.fillRect(0, 0, w, h);
    };

    const tick = () => {
      ctx.clearRect(0, 0, w, h);
      paintBase();
      for (let i = drops.length - 1; i >= 0; i--) {
        const d = drops[i];
        d.life++;
        d.y += d.vy;
        d.x += Math.sin(d.life * 0.007 + d.phase) * 0.4 + d.drift * 0.01;
        d.r += d.grow;
        const t = d.life / d.ttl;
        const fade = Math.sin(Math.min(t, 1) * Math.PI);
        paint(d, Math.max(0, fade) * 0.45);
        if (t >= 1 || d.y + d.r < -20) drops.splice(i, 1);
      }
      ctx.globalAlpha = 1;
      if (frame % 72 === 0 && drops.length < 10) spawn();
      frame++;
      raf = requestAnimationFrame(tick);
    };

    resize();
    window.addEventListener("resize", resize);

    if (reduce) {
      paintBase();
      for (let i = 0; i < 4; i++) {
        const d = { x: w * rand(0.25, 0.75), y: h * rand(0.5, 0.92), r: w * rand(0.12, 0.2), color: palette[i % palette.length] };
        paint(d, 0.5);
      }
      ctx.globalAlpha = 1;
      return;
    }

    for (let i = 0; i < 5; i++) { spawn(); const d = drops[drops.length - 1]; d.life = i * 90; d.y = h * rand(0.45, 0.95); }
    raf = requestAnimationFrame(tick);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) { cancelAnimationFrame(raf); raf = 0; }
      else if (!raf) raf = requestAnimationFrame(tick);
    });
  };

  // ── Orchestration ──────────────────────────────────────────────────
  const initHero = () => {
    const canvas = document.querySelector("[data-hero-fluid]");
    const bagBody = document.querySelector("[data-bag-body]");
    if (!(canvas instanceof HTMLCanvasElement) || canvas.dataset.init === "1") return;
    canvas.dataset.init = "1";

    // Bag liquid: real-time GPU fluid when possible, soft blooms otherwise.
    let fluid: ReturnType<typeof initHeroFluidGL> = null;
    if (!reduce && bagBody instanceof HTMLElement) {
      try {
        fluid = initHeroFluidGL(canvas, bagBody, palette);
      } catch {
        fluid = null;
      }
    }
    if (!fluid) initHeroFluid2D(canvas);

    // 2.5D: the bag leans toward the pointer and the liquid sloshes with
    // it. Desktop, fine-pointer, motion-safe only; eased so it feels like
    // weight, not tracking.
    const tiltBag = document.querySelector(".hero__bag");
    const heroSection = document.querySelector("[data-hero]");
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    if (
      tiltBag instanceof HTMLElement &&
      heroSection instanceof HTMLElement &&
      fine &&
      !reduce &&
      window.matchMedia("(min-width: 1000px)").matches
    ) {
      let nx = 0, ny = 0, cx = 0, cy = 0, traf = 0;
      const settle = () => {
        traf = 0;
        cx += (nx - cx) * 0.1;
        cy += (ny - cy) * 0.1;
        tiltBag.style.setProperty("--nx", cx.toFixed(3));
        tiltBag.style.setProperty("--ny", cy.toFixed(3));
        fluid?.setTilt(cx * 0.7);
        if (Math.abs(nx - cx) > 0.003 || Math.abs(ny - cy) > 0.003) {
          traf = requestAnimationFrame(settle);
        }
      };
      heroSection.addEventListener(
        "pointermove",
        (e) => {
          const r = tiltBag.getBoundingClientRect();
          nx = Math.max(-1, Math.min(1, (e.clientX - (r.left + r.width / 2)) / (window.innerWidth * 0.5)));
          ny = Math.max(-1, Math.min(1, (e.clientY - (r.top + r.height / 2)) / (window.innerHeight * 0.5)));
          if (!traf) traf = requestAnimationFrame(settle);
        },
        { passive: true }
      );
      heroSection.addEventListener("pointerleave", () => {
        nx = 0;
        ny = 0;
        if (!traf) traf = requestAnimationFrame(settle);
      });
    }

    // Arrival states: cycle through how people actually show up, each word
    // dissolving like ink, then settle. Static under reduced motion.
    const arrive = document.querySelector("[data-arrive]");
    if (arrive instanceof HTMLElement && !reduce) {
      const words = [
        "Jetlagged.",
        "Run down.",
        "Recovering.",
        "Burnt out.",
        "Just tired.",
        "However you arrive.",
      ];
      let wi = 0;
      const next = () => {
        arrive.classList.add("is-out");
        window.setTimeout(() => {
          wi++;
          arrive.textContent = words[wi];
          arrive.classList.remove("is-out");
          if (wi < words.length - 1) window.setTimeout(next, 1900);
        }, 440);
      };
      arrive.textContent = words[0];
      window.setTimeout(next, 1800);
    }

    // The honest menu: re-roll three fresh items per visit, then arm the
    // strike-through choreography to fire when the section scrolls in. We
    // update the existing server-rendered rows (which carry Astro's scoped
    // style attribute) rather than replacing them, so the layout is kept.
    const honest = document.querySelector("[data-honest]");
    if (honest instanceof HTMLElement) {
      const rows = Array.from(honest.querySelectorAll<HTMLElement>(".honest__row"));
      const pick = [...honestMenu.keys()]
        .sort(() => Math.random() - 0.5)
        .slice(0, rows.length)
        .map((i) => honestMenu[i]);
      rows.forEach((row, i) => {
        const item = pick[i];
        if (!item) return;
        const hype = row.querySelector<HTMLElement>(".honest__hype");
        const strike = hype?.querySelector(".honest__strike");
        if (hype && strike) {
          hype.textContent = "“" + item.hype + "”";
          hype.appendChild(strike);
        }
        const truth = row.querySelector<HTMLElement>(".honest__truth");
        if (truth) truth.textContent = item.truth;
      });
    }
    if (honest instanceof HTMLElement && !reduce && "IntersectionObserver" in window) {
      honest.dataset.armed = "1";
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              honest.classList.add("honest--go");
              io.disconnect();
            }
          });
        },
        { threshold: 0.3 }
      );
      io.observe(honest);
    }

    // Entrance overture is skippable: any scroll intent jumps to settled.
    const hero = document.querySelector("[data-hero]");
    if (hero instanceof HTMLElement && !reduce) {
      const skip = () => hero.classList.add("hero--skip");
      const opts = { once: true, passive: true } as const;
      window.addEventListener("wheel", skip, opts);
      window.addEventListener("touchmove", skip, opts);
      window.addEventListener("keydown", skip, opts);
      window.setTimeout(() => {
        window.removeEventListener("wheel", skip);
        window.removeEventListener("touchmove", skip);
        window.removeEventListener("keydown", skip);
      }, 2600);
    }

    // The travelling drop: detaches from the bag as it scrolls out of view,
    // rides down the page, and lands in the closing band as a ripple.
    const drop = document.querySelector("[data-scroll-drop]");
    const bag = document.querySelector(".hero__bag");
    const band = document.querySelector(".band");
    const wide = window.matchMedia("(min-width: 1000px)").matches;
    if (drop instanceof HTMLElement && bag && band && !reduce && wide) {
      // The drop's journey is anchored in document space: it forms on the
      // bag's nozzle tip, detaches as you scroll, and lands inside the CTA
      // band. Its document position interpolates tip -> band while the page
      // scrolls underneath, so it appears to ride the whole page down.
      let tipDoc = 0, tipX = 0, landDoc = 0, endScroll = 0, landed = false, raf = 0;

      const measure = () => {
        const sy = window.scrollY;
        const vh = window.innerHeight;
        const bagR = bag.getBoundingClientRect();
        const bandR = band.getBoundingClientRect();
        tipX = bagR.left + bagR.width / 2 - 7.5;
        tipDoc = sy + bagR.bottom - 4; // the nozzle tip
        landDoc = sy + bandR.top + vh * 0.18; // a point inside the band
        endScroll = sy + bandR.top - vh * 0.5; // band comfortably in view
        if (endScroll < 200) endScroll = 200;
      };

      const rippleAt = (x: number, y: number) => {
        for (const cls of ["drop-ripple", "drop-ripple drop-ripple--late"]) {
          const r = document.createElement("span");
          r.className = cls;
          r.style.left = x + 7.5 + "px";
          r.style.top = y + "px";
          r.addEventListener("animationend", () => r.remove(), { once: true });
          document.body.appendChild(r);
        }
      };

      const update = () => {
        raf = 0;
        const sy = window.scrollY;
        const p = Math.min(1, Math.max(0, sy / endScroll));
        if (p < 1) landed = false;
        else if (landed) return;
        const docY = tipDoc + (landDoc - tipDoc) * p;
        const vpY = docY - sy;
        if (p >= 1) {
          landed = true;
          drop.style.opacity = "0";
          rippleAt(tipX, vpY);
          // The strike spreads through the water: nearby ripple headings
          // (the band's own words) warp outward from the landing point.
          (window as any).__titleRipple?.(tipX + 7.5, vpY, 3);
          return;
        }
        if (vpY < -40 || vpY > window.innerHeight + 40) {
          drop.style.opacity = "0";
          return;
        }
        // Forms at the tip (small), swells as it detaches; sways in transit.
        const grow = Math.min(1, p / 0.06);
        const sway = Math.sin(p * Math.PI * 3.5) * 6 * grow;
        drop.style.opacity = "0.9";
        drop.style.transform = `translate3d(${(tipX + sway).toFixed(1)}px, ${vpY.toFixed(1)}px, 0) scale(${(0.55 + grow * 0.45).toFixed(3)})`;
      };

      const onScroll = () => {
        if (!raf) raf = requestAnimationFrame(update);
      };
      measure();
      // Let the bag finish drawing itself before the drop forms on its tip.
      window.setTimeout(update, 1500);
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", () => { measure(); onScroll(); });
    }
  };

  if (document.readyState !== "loading") initHero();
  else document.addEventListener("DOMContentLoaded", initHero);
  document.addEventListener("astro:page-load", initHero);
</script>
