---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site, locations, isFilled } from '@/data/site';

const jsonLd = locations
  .filter((l) => l.name)
  .map((loc) => ({
    '@context': 'https://schema.org',
    '@type': 'MedicalClinic',
    name: `${site.brand} · ${loc.name}`,
    ...(isFilled(loc.address) ? { address: loc.address } : {}),
    ...(isFilled(site.phone) ? { telephone: site.phone } : {}),
    email: site.email,
    url: new URL('/contact', Astro.site).href,
  }));
---

<Layout
  title="Contact"
  description="Contact Restoration Medical infusion therapy in Thornhill and Woodbridge. Locations, hours, phone, and email. Warm, personal, and happy to help."
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="Contact"
    lead="We are happy to hear from you, whether you are ready to book or simply have a question. Warm, personal, and never a hard sell."
  >
    Come say hello, <span class="it">or send a note.</span>
  </PageHeader>

  <section class="section-tight">
    <div class="wrap">
      <div class="locs reveal">
        {locations.map((loc) => (
          <article class="loc">
            <h2 class="loc__name">{loc.name}</h2>
            {isFilled(loc.address)
              ? <p class="loc__meta">{loc.address}</p>
              : <p class="loc__meta loc__meta--tba">Address details coming soon.</p>}
            {isFilled(loc.hours) && <p class="loc__meta">{loc.hours}</p>}
            {isFilled(loc.mapUrl) && (
              <a class="link-arrow" href={loc.mapUrl} target="_blank" rel="noopener">Get directions &rarr;</a>
            )}
          </article>
        ))}
      </div>

      <div class="reach reveal">
        <div class="reach__col">
          <p class="eyebrow">Reach us</p>
          <p class="reach__line"><a href={`mailto:${site.email}`}>{site.email}</a></p>
          {isFilled(site.phone) && <p class="reach__line"><a href={`tel:${site.phone}`}>{site.phone}</a></p>}
        </div>
        <div class="reach__col">
          <p class="eyebrow">Ready when you are</p>
          <a class="btn" href="/book">Book a consult</a>
        </div>
      </div>

      <p class="signoff reveal">{site.signOff}</p>
    </div>
  </section>

  <CtaBand showLocations={true} />
</Layout>

<style>
  .locs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }
  .loc {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem;
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .loc__name {
    font-size: var(--step-2);
  }
  .loc__meta {
    color: var(--graphite);
    font-size: var(--step--1);
  }
  .loc__meta--tba {
    color: var(--mist);
    font-style: italic;
  }
  .loc .link-arrow {
    margin-top: 0.6rem;
  }
  .reach {
    margin-top: 1.2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
    border-top: 1px solid var(--line);
    padding-top: var(--space-m);
  }
  .reach__col {
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }
  .reach__line {
    font-family: var(--display);
    font-size: var(--step-1);
  }
  .reach__line a {
    text-decoration: none;
  }
  .reach__line a:hover {
    color: var(--mist);
  }
  .signoff {
    margin-top: var(--space-m);
    font-family: var(--display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--graphite);
  }
  @media (max-width: 820px) {
    .locs,
    .reach {
      grid-template-columns: 1fr;
    }
  }
</style>
