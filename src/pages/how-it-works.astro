---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CtaBand from '@/components/CtaBand.astro';

const steps = [
  { n: '01', t: 'Intake & screening', d: 'We review your health history, medications, and goals. This is where we make sure a treatment is safe and sensible for you, and where we will say so honestly if it is not.' },
  { n: '02', t: 'Settle into the chair', d: 'A registered nurse places a small IV, or gives your shot. The space is calm and private. Most people read, work, or simply rest.' },
  { n: '03', t: 'The infusion', d: 'A drip usually runs around forty-five minutes, longer for NAD+. A shot takes about five. Your nurse stays close and paces things for comfort.' },
  { n: '04', t: 'After', d: 'You can return to your day. We will suggest a sensible cadence if a treatment suits you, never a hard sell.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: 'How infusion therapy works',
  description:
    'How IV infusion therapy and injection shots work at Restoration Medical, what to expect step by step, and who reviews and administers your treatment.',
  url: new URL('/how-it-works', Astro.site).href,
};
---

<Layout
  title="How It Works"
  description="How IV infusion therapy and injection shots work at Restoration Medical. What to expect step by step, drips versus shots, and the physician and nurse who care for you."
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="How It Works"
    lead="Calm, clinical, and clear. Here is what infusion therapy is, why the way it is delivered matters, and exactly what to expect when you visit."
  >
    What happens, <span class="it">from the first drop.</span>
  </PageHeader>

  <section class="section-tight">
    <div class="wrap-narrow stack-lg">
      <div class="reveal block">
        <h2 class="block__h">What IV therapy is</h2>
        <p class="block__p">
          Intravenous therapy delivers fluids, vitamins, and minerals directly
          into the bloodstream. Because it does not pass through digestion, the
          body can take up certain nutrients more readily than from a tablet.
          That is the honest case for it. It is a way to support how you feel,
          not a cure, and it works best alongside good sleep, food, and habits.
        </p>
      </div>
      <div class="reveal block">
        <h2 class="block__h">Why delivery matters, without overstating it</h2>
        <p class="block__p">
          For some nutrients, an infusion can support levels more directly than
          oral supplements, which is useful when your body is depleted or when
          absorption is the limiting factor. We are careful not to overclaim.
          Where the evidence is still developing, such as for NAD+, we say so.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight fill">
    <div class="wrap">
      <div class="reveal sec-head">
        <p class="eyebrow">What to expect</p>
        <h2 class="hl display-3">Four calm steps.</h2>
      </div>
      <ol class="steps reveal">
        {steps.map((s) => (
          <li class="step">
            <span class="step__n meta tnum">{s.n}</span>
            <h3 class="step__t">{s.t}</h3>
            <p class="step__d">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="two">
        <article class="reveal panel">
          <h2 class="panel__h">Drips or shots: when each makes sense</h2>
          <p class="panel__p">
            A drip suits a fuller blend and a calmer, longer session. A shot is
            fast, focused support in about five minutes, easy to keep on a
            regular rhythm or to add alongside an aesthetics visit. Many people
            use both. Your nurse helps you choose.
          </p>
          <div class="panel__links">
            <a class="link-arrow" href="/drips">See all drips &rarr;</a>
            <a class="link-arrow" href="/shots">Visit the Injection Bar &rarr;</a>
          </div>
        </article>
        <article class="reveal panel">
          <h2 class="panel__h">Who reviews and administers</h2>
          <p class="panel__p">
            Every treatment is reviewed by our physician and given by a
            registered nurse. That oversight is the quiet difference between a
            real clinic and a drip bar. If anything about your health calls for
            caution, we will adjust or decline, and tell you why.
          </p>
          <div class="panel__links">
            <a class="link-arrow" href="/about">Meet the approach &rarr;</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section-tight fill">
    <div class="wrap-narrow reveal">
      <p class="eyebrow">For the needle-nervous</p>
      <h2 class="hl display-3 reassure">It is gentler than you expect.</h2>
      <p class="block__p">
        If needles make you uneasy, you are in good company, and you are in good
        hands. Our nurses do this every day, the placement is quick, and you set
        the pace. Tell us at intake and we will take extra care. You can pause
        or stop at any time.
      </p>
      <div class="reassure__links">
        <a class="link-arrow" href="/safety">Read about safety &amp; screening &rarr;</a>
        <a class="link-arrow" href="/faq">Common questions, answered &rarr;</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .stack-lg {
    display: grid;
    gap: var(--space-m);
  }
  .block__h {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }
  .block__p {
    color: var(--graphite);
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .sec-head {
    display: grid;
    gap: 0.7rem;
    margin-bottom: var(--space-m);
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .step {
    border-top: 1px solid var(--ink);
    padding-top: 1.1rem;
    display: grid;
    gap: 0.6rem;
  }
  .step__t {
    font-size: var(--step-1);
  }
  .step__d {
    color: var(--graphite);
    font-size: var(--step--1);
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .panel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem;
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .panel__h {
    font-size: var(--step-1);
  }
  .panel__p {
    color: var(--graphite);
  }
  .panel__links {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .reassure {
    margin-block: 0.6rem 1.2rem;
  }
  .reassure__links {
    margin-top: 1.2rem;
  }
  @media (max-width: 820px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
    .two {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
