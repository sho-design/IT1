---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CtaBand from '@/components/CtaBand.astro';
import { ingredients } from '@/data/ingredients';

// Educational configurator. No pricing. The nurse finalises the blend.
// `hasC` marks bases that already contain vitamin C, which matters for the
// vitamin C / glutathione separation flagged in the summary. Each base has
// its own accent (outside the family palette) and a line icon.
const bases = [
  { id: 'hydrate', name: 'Hydration base', note: 'Electrolytes and fluids, the canvas for everything else.', hasC: false, accent: 'var(--base-hydrate)' },
  { id: 'myers', name: "Healing base", note: "Our Myers' style blend of B vitamins, vitamin C, and minerals.", hasC: true, accent: 'var(--base-healing)' },
  { id: 'foundation', name: 'Foundation base', note: 'A balanced everyday baseline of core vitamins and minerals.', hasC: true, accent: 'var(--base-foundation)' },
];

// Line icons keyed to each base id, same style as the concern icons.
const baseIcons: Record<string, string> = {
  // Waves: hydration
  hydrate: '<path d="M3 8c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/><path d="M3 14c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/>',
  // Cross in a circle: a healing, restorative blend
  myers: '<circle cx="12" cy="12" r="8.5"/><path d="M12 8v8M8 12h8"/>',
  // Stacked layers: a baseline foundation
  foundation: '<path d="M12 4 3 8.5l9 4.5 9-4.5z"/><path d="M3 13.5 12 18l9-4.5"/>',
};

// Offer wellness boosters only (no clinical iron in a build-your-own).
const boosters = ingredients.filter(
  (i) => !['iron-sucrose'].includes(i.slug)
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Build Your Own Infusion',
  description:
    'An educational way to understand what goes into a personalised IV drip at Restoration Medical. Choose a base, explore boosters. Your nurse finalises the blend.',
  url: new URL('/drips/build-your-own', Astro.site).href,
};
---

<Layout
  title="Build Your Own"
  description="Build your own infusion at Restoration Medical. An educational configurator: choose a base, explore boosters, and see what each one supports. Your nurse finalises your blend. No pricing."
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="Build Your Own · Design your infusion"
    accent="var(--accent-neutral)"
    lead="A clear way to learn what goes into a drip. Choose a base, explore the boosters, and see what each one supports. This is educational. Your nurse finalises your blend after a brief screening."
  >
    Design your infusion, <span class="it">understand every drop.</span>
  </PageHeader>

  <section class="section-tight">
    <div class="wrap byo">
      <div class="byo__build">
        <div class="byo__step reveal">
          <p class="eyebrow">Step one · Choose a base</p>
          <div class="bases" role="radiogroup" aria-label="Choose a base">
            {bases.map((b, i) => (
              <button
                class="base"
                role="radio"
                aria-checked={i === 0 ? 'true' : 'false'}
                data-base={b.id}
                data-name={b.name}
                data-has-c={String(b.hasC)}
                style={`--accent:${b.accent}`}
              >
                <span class="base__icon" aria-hidden="true">
                  <svg
                    class="cicon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={baseIcons[b.id]}
                  ></svg>
                </span>
                <span class="base__text">
                  <span class="base__name">{b.name}</span>
                  <span class="base__note">{b.note}</span>
                </span>
              </button>
            ))}
          </div>
        </div>

        <div class="byo__step reveal">
          <p class="eyebrow">Step two · Add boosters</p>
          <p class="byo__hint meta">Tap to explore. Each booster lists what it may support. A few cannot share one bag, we will flag those in your blend as you build.</p>
          <div class="boosters">
            {boosters.map((ing) => (
              <button
                class="booster"
                aria-pressed="false"
                data-slug={ing.slug}
                data-name={ing.name}
                style={`--dot: var(--accent-${ing.family})`}
              >
                <span class="booster__dot" aria-hidden="true"></span>
                <span class="booster__name">{ing.name}</span>
                <span class="booster__line">{ing.oneLine}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <aside class="byo__summary reveal" aria-live="polite">
        <div class="summary">
          <p class="eyebrow">Your blend, so far</p>
          <p class="summary__base" data-summary-base>Hydration base</p>
          <ul class="summary__list" data-summary-list>
            <li class="summary__empty">No boosters added yet. Tap any booster to add it.</li>
          </ul>
          <div class="advisories" data-summary-notes hidden></div>
          <p class="summary__note meta">
            This is an educational sketch, not a prescription. Not every
            combination goes in one bag, and not every booster suits everyone.
            Your nurse finalises your blend after screening, on clinical
            grounds. No pricing.
          </p>
          <a class="btn summary__cta" href="/book" data-summary-cta>Bring this to a consult</a>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand
    eyebrow="Prefer a starting point?"
    heading="Our signature drips are a good place to begin."
    body="If a blank canvas feels like a lot, our signature drips are thoughtfully composed for common goals. You can always adjust with your nurse."
    secondaryLabel="See signature drips"
    secondaryHref="/drips"
  />
</Layout>

<style>
  .byo {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    align-items: start;
  }
  .byo__build {
    display: grid;
    gap: var(--space-l);
  }
  .byo__step {
    display: grid;
    gap: 1rem;
  }
  .bases {
    display: grid;
    gap: 0.8rem;
  }
  .base {
    text-align: left;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem;
    cursor: pointer;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.9rem;
    align-items: center;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .base__icon {
    color: var(--accent);
    font-size: 1.55rem;
    display: grid;
    place-items: center;
  }
  .base__text {
    display: grid;
    gap: 0.3rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .base:hover {
      border-color: var(--accent);
    }
  }
  .base[aria-checked='true'] {
    border-color: var(--accent);
    box-shadow: inset 3px 0 0 var(--accent);
  }
  .base__name {
    font-family: var(--display);
    font-size: var(--step-1);
  }
  .base__note {
    color: var(--graphite);
    font-size: var(--step--1);
  }
  .boosters {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.7rem;
  }
  .booster {
    text-align: left;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
    cursor: pointer;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.6rem;
    align-items: baseline;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  .booster__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--dot);
    align-self: center;
    transition: box-shadow 0.2s var(--ease);
  }
  .booster__name {
    font-size: var(--step-0);
    transition: color 0.2s var(--ease);
  }
  .booster__line {
    grid-column: 2;
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--mist);
  }
  /* Hover: outline in the ingredient's own colour, white card kept. The name
     is darkened slightly toward ink so lighter accents stay legible. */
  @media (hover: hover) and (pointer: fine) {
    .booster:hover {
      border-color: var(--dot);
    }
    .booster:hover .booster__name {
      color: color-mix(in srgb, var(--dot) 70%, var(--ink));
    }
    .booster:hover .booster__dot {
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--dot) 22%, transparent);
    }
  }
  /* Selected: a light tint of the ingredient's colour fills the card. */
  .booster[aria-pressed='true'] {
    border-color: var(--dot);
    background: color-mix(in srgb, var(--dot) 12%, var(--paper));
  }
  .booster[aria-pressed='true'] .booster__name {
    color: color-mix(in srgb, var(--dot) 70%, var(--ink));
  }
  .booster[aria-pressed='true'] .booster__dot {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--dot) 30%, transparent);
  }

  .byo__summary {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .summary {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem 1.5rem;
    display: grid;
    gap: 1rem;
    background: var(--cloud);
  }
  .summary__base {
    font-family: var(--display);
    font-size: var(--step-1);
  }
  .summary__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }
  .summary__list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
  }
  .summary__empty {
    color: var(--mist);
    font-style: italic;
  }
  .summary__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }
  .advisories {
    display: grid;
    gap: 0.5rem;
  }
  .advisory {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.55rem;
    align-items: start;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink);
    background: color-mix(in srgb, var(--accent-clinical) 12%, var(--paper));
    border: 1px solid color-mix(in srgb, var(--accent-clinical) 35%, var(--line));
    border-left: 3px solid var(--accent-clinical);
    border-radius: var(--radius);
    padding: 0.75rem 0.85rem;
  }
  .advisory::before {
    content: '!';
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: var(--accent-clinical);
    color: var(--paper);
    font-family: var(--mono);
    font-weight: 600;
    font-size: 0.72rem;
    line-height: 1;
  }
  .summary__cta {
    justify-content: center;
  }

  @media (max-width: 860px) {
    .byo {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .byo__summary {
      position: static;
    }
  }
</style>

<script>
  // Re-run on every page load, including view-transition navigations. Guards
  // against pages without the configurator, so it is safe to fire globally.
  const initBuildYourOwn = () => {
  const bases = document.querySelectorAll<HTMLButtonElement>('.base');
  if (!bases.length) return;
  const boosters = document.querySelectorAll<HTMLButtonElement>('.booster');
  const sumBase = document.querySelector('[data-summary-base]');
  const sumList = document.querySelector('[data-summary-list]');
  const sumNotes = document.querySelector<HTMLElement>('[data-summary-notes]');
  const sumCta = document.querySelector<HTMLAnchorElement>('[data-summary-cta]');

  const chosenBoosters = () =>
    Array.from(boosters).filter(
      (b) => b.getAttribute('aria-pressed') === 'true'
    );
  const activeBase = () =>
    Array.from(bases).find((b) => b.getAttribute('aria-checked') === 'true');

  // Combinations that are not given in one bag. Kept deliberately narrow to
  // the well-established cases; the nurse screening covers the rest.
  const advisoryRules: Array<{
    applies: (slugs: Set<string>, base?: HTMLButtonElement) => boolean;
    text: string;
  }> = [
    {
      applies: (slugs, base) =>
        slugs.has('glutathione') &&
        (slugs.has('vitamin-c') || base?.dataset.hasC === 'true'),
      text:
        'Vitamin C and glutathione are not combined in one bag, the vitamin C would break the glutathione down. They are given separately, or on different visits, and your nurse sets the order.',
    },
    {
      applies: (slugs, base) =>
        slugs.has('nad') &&
        (slugs.size > 1 || (base ? base.dataset.base !== 'hydrate' : false)),
      text:
        'NAD+ is given as its own slow infusion rather than blended with a base or other boosters. Your nurse will usually schedule it on its own.',
    },
  ];

  const renderNotes = () => {
    if (!sumNotes) return;
    const slugs = new Set(
      chosenBoosters().map((b) => b.dataset.slug || '')
    );
    const base = activeBase();
    const notes = advisoryRules
      .filter((r) => r.applies(slugs, base))
      .map((r) => r.text);
    sumNotes.innerHTML = '';
    if (notes.length === 0) {
      sumNotes.hidden = true;
      return;
    }
    sumNotes.hidden = false;
    notes.forEach((t) => {
      const p = document.createElement('p');
      p.className = 'advisory';
      p.textContent = t;
      sumNotes.appendChild(p);
    });
  };

  // Carry the current blend to the consult form via the URL, so the booking
  // message arrives pre-filled with the base and boosters chosen here.
  const updateCta = () => {
    if (!sumCta) return;
    const base = activeBase();
    const baseName = base?.dataset.name || 'Hydration base';
    const chosen = chosenBoosters().map((b) => b.dataset.name || '');
    const boosters = chosen.length ? chosen.join(', ') : 'none selected yet';
    const message =
      'I would like to discuss a Build Your Own infusion.\n' +
      `Base: ${baseName}.\n` +
      `Boosters: ${boosters}.`;
    const params = new URLSearchParams({
      interest: 'A specific drip or shot',
      build: message,
    });
    sumCta.href = `/book?${params.toString()}`;
  };

  bases.forEach((b) => {
    b.addEventListener('click', () => {
      bases.forEach((x) => x.setAttribute('aria-checked', 'false'));
      b.setAttribute('aria-checked', 'true');
      if (sumBase) sumBase.textContent = b.dataset.name || 'Base';
      renderNotes();
      updateCta();
    });
  });

  const render = () => {
    if (!sumList) return;
    const chosen = chosenBoosters();
    sumList.innerHTML = '';
    if (chosen.length === 0) {
      const li = document.createElement('li');
      li.className = 'summary__empty';
      li.textContent = 'No boosters added yet. Tap any booster to add it.';
      sumList.appendChild(li);
    } else {
      chosen.forEach((b) => {
        const li = document.createElement('li');
        const dot = document.createElement('span');
        dot.className = 'summary__dot';
        const color = getComputedStyle(b).getPropertyValue('--dot');
        dot.style.background = color;
        const name = document.createElement('span');
        name.textContent = b.dataset.name || '';
        li.append(dot, name);
        sumList.appendChild(li);
      });
    }
    renderNotes();
    updateCta();
  };

  updateCta();

  boosters.forEach((b) => {
    b.addEventListener('click', () => {
      const on = b.getAttribute('aria-pressed') === 'true';
      b.setAttribute('aria-pressed', String(!on));
      render();
    });
  });
  };

  document.addEventListener('astro:page-load', initBuildYourOwn);
</script>
