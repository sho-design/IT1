---
import Layout from '@/layouts/Layout.astro';
import CtaBand from '@/components/CtaBand.astro';

const journey = [
  { n: '01', t: 'Assessment', d: 'A full medical assessment of your health, history, and goals. The physician decides whether the program, and which therapies within it, are appropriate for you.' },
  { n: '02', t: 'A personalized plan', d: 'A plan built around you, which may include GLP-1 therapy where suitable, nutrition guidance, and metabolic injections as supporting tools.' },
  { n: '03', t: 'Ongoing support', d: 'Regular check-ins, monitoring, and adjustments. Weight is personal, and steady support matters more than any single step.' },
  { n: '04', t: 'Maintenance', d: 'As goals are met, the focus shifts to maintaining them, with a lighter touch and the same medical oversight.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: 'Metabolic Program',
  description:
    'A physician-supervised, medically guided weight-management program at Restoration Medical. GLP-1 therapy where appropriate, with monitoring and support.',
  url: new URL('/metabolic-program', Astro.site).href,
};
---

<Layout
  title="Metabolic Program"
  description="A physician-led, medically supervised weight-management program at Restoration Medical. GLP-1 therapy where appropriate, with monitoring, support, and metabolic injections. Results vary."
  jsonLd={jsonLd}
>
  <header class="mhead reveal">
    <div class="wrap">
      <p class="eyebrow mhead__eyebrow">
        <span class="mhead__dot" aria-hidden="true"></span>
        Physician-Led Program
      </p>
      <h1 class="hl mhead__title">
        <span class="lg">A medical approach to weight,</span>
        <span class="lg"><span class="it">built around you.</span></span>
      </h1>
      <p class="lead mhead__lead">
        A physician-supervised weight-management program. Where appropriate, it
        may include GLP-1 therapy, alongside monitoring, support, and metabolic
        injections as part of the journey. Not a quick fix. A real plan, with
        real oversight.
      </p>
      <div class="mhead__actions">
        <a class="btn btn--lg" href="/book">Request a consult</a>
        <a class="link-arrow" href="/concerns/weight-metabolism">See weight &amp; metabolism &rarr;</a>
      </div>
    </div>
  </header>

  <section class="section-tight fill">
    <div class="wrap">
      <div class="reveal sec-head">
        <p class="eyebrow">The journey</p>
        <h2 class="hl display-3">Steady, supported, supervised.</h2>
      </div>
      <ol class="steps reveal">
        {journey.map((s) => (
          <li class="step">
            <span class="step__n meta tnum">{s.n}</span>
            <h3 class="step__t">{s.t}</h3>
            <p class="step__d">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap-narrow stack-lg">
      <div class="reveal block">
        <h2 class="block__h">How we frame it</h2>
        <p class="block__p">
          This is support within a medically guided program, not a standalone
          treatment or a shortcut. Metabolic injections and drips are tools
          inside a bigger plan that includes nutrition and activity. Results
          vary, and suitability is always determined by the physician. We do not
          present medications as a menu to pick from. Your physician decides
          what is right and safe for you.
        </p>
      </div>
      <div class="reveal block block--soft">
        <h2 class="block__h">The whole picture</h2>
        <p class="block__p">
          As goals are met, we care for the whole picture, including how you feel
          in your skin and body. Where it helps, we can connect you with the
          right aesthetic support, without overpromising what any single step
          can do.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Begin"
    heading="A consult is where it starts."
    body="Tell us your goals. The physician will assess whether the program is right for you, and build a plan around your life if it is."
    primaryLabel="Request a consult"
    secondaryLabel="Read about safety"
    secondaryHref="/safety"
  />
</Layout>

<style>
  .mhead {
    --accent: var(--accent-metabolic);
    padding-top: var(--space-xl);
    padding-bottom: var(--space-m);
    border-bottom: 1px solid var(--line);
  }
  .mhead__eyebrow {
    color: #566f46;
    margin-bottom: 1.4rem;
  }
  .mhead__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }
  .mhead__title {
    font-size: var(--step-4);
    max-width: 20ch;
  }
  .mhead__lead {
    margin-top: 1.8rem;
  }
  .mhead__actions {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .sec-head {
    display: grid;
    gap: 0.7rem;
    margin-bottom: var(--space-m);
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .step {
    border-top: 1px solid var(--ink);
    padding-top: 1.1rem;
    display: grid;
    gap: 0.6rem;
  }
  .step__t {
    font-size: var(--step-1);
  }
  .step__d {
    color: var(--graphite);
    font-size: var(--step--1);
  }
  .stack-lg {
    display: grid;
    gap: var(--space-m);
  }
  .block__h {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }
  .block__p {
    color: var(--graphite);
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .block--soft {
    border-top: 1px solid var(--line);
    padding-top: var(--space-m);
  }
  @media (max-width: 820px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
