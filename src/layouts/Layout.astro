---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = site.description,
  noindex = false,
  jsonLd,
} = Astro.props;

const fullTitle =
  title === 'home'
    ? `${site.fullName} · ${site.tagline}`
    : `${title} · ${site.fullName}`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,340;0,9..144,380;0,9..144,480;1,9..144,340;1,9..144,440&family=Inter+Tight:wght@400;500;600&family=Spline+Sans+Mono:wght@400;500&display=swap"
    />

    {ld.map((node) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(node)}
      />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <div class="droplet" aria-hidden="true"></div>

    <script>
      // Reveal-on-scroll runtime. Below-the-fold only; above-the-fold uses
      // a CSS-only entrance so the LCP text is never held at opacity:0.
      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;
      const items = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        items.forEach((el) => io.observe(el));
      }

      // Droplet cursor: a soft accent droplet that eases toward the pointer
      // and swells over interactive elements. Fine-pointer only; off for
      // reduced-motion.
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const droplet = document.querySelector('.droplet') as HTMLElement | null;
      if (droplet && fine && !reduce) {
        let tx = -100, ty = -100, x = -100, y = -100, raf = 0, active = false;
        const loop = () => {
          x += (tx - x) * 0.18;
          y += (ty - y) * 0.18;
          droplet.style.transform =
            'translate3d(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px,0)';
          raf = requestAnimationFrame(loop);
        };
        window.addEventListener(
          'pointermove',
          (e) => {
            tx = e.clientX;
            ty = e.clientY;
            if (!active) {
              active = true;
              droplet.classList.add('is-active');
            }
            const hot = !!(e.target as Element)?.closest?.(
              'a, button, .card, .tile, .booster, .base, .chip, summary, [role="radio"]'
            );
            droplet.classList.toggle('is-hot', hot);
            if (!raf) raf = requestAnimationFrame(loop);
          },
          { passive: true }
        );
        document.addEventListener('pointerleave', () => {
          droplet.classList.remove('is-active');
        });
      }

      // Title water-ripple: split headings into letters, and on pointer move a
      // damped wave travels out from where the cursor crosses the words, keeps
      // moving, then slowly settles.
      if (fine && !reduce) {
        const splitHeading = (el: Element) => {
          if ((el as HTMLElement).dataset.split) return;
          (el as HTMLElement).dataset.split = '1';
          const walk = (node: Node) => {
            Array.from(node.childNodes).forEach((child) => {
              if (child.nodeType === 3) {
                const text = child.textContent || '';
                if (!text.trim() && !/\S/.test(text)) return;
                const frag = document.createDocumentFragment();
                text.split(/(\s+)/).forEach((tok) => {
                  if (tok === '') return;
                  if (/^\s+$/.test(tok)) {
                    frag.appendChild(document.createTextNode(tok));
                    return;
                  }
                  const word = document.createElement('span');
                  word.className = 'rw';
                  for (const ch of tok) {
                    const l = document.createElement('span');
                    l.className = 'rl';
                    l.textContent = ch;
                    word.appendChild(l);
                  }
                  frag.appendChild(word);
                });
                child.parentNode?.replaceChild(frag, child);
              } else if (child.nodeType === 1) {
                walk(child);
              }
            });
          };
          walk(el);
        };

        type RState = {
          letters: HTMLElement[];
          centers: { x: number; y: number }[];
          waves: { x: number; y: number; t0: number }[];
          raf: number;
          lastInject: number;
          lastMeasure: number;
          lastX: number;
          lastY: number;
        };
        const states = new WeakMap<Element, RState>();
        // Tuning: speed (px/s), pulse width, wavelength, amplitude, settle (s),
        // and D = how tightly the ripple stays near the cursor.
        const V = 240, PW = 26, WL = 78, AMP = 10, TAU = 0.95, D = 230;

        const measure = (st: RState) => {
          st.centers = st.letters.map((l) => {
            const r = l.getBoundingClientRect();
            return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
          });
          st.lastMeasure = performance.now();
        };

        const ensure = (el: Element): RState => {
          let st = states.get(el);
          if (!st) {
            splitHeading(el);
            st = {
              letters: Array.from(el.querySelectorAll<HTMLElement>('.rl')),
              centers: [],
              waves: [],
              raf: 0,
              lastInject: 0,
              lastMeasure: 0,
              lastX: 0,
              lastY: 0,
            };
            measure(st);
            states.set(el, st);
          }
          return st;
        };

        const frame = (el: Element) => {
          const st = states.get(el);
          if (!st) return;
          const now = performance.now();
          st.waves = st.waves.filter((w) => (now - w.t0) / 1000 < TAU * 4);
          for (let i = 0; i < st.letters.length; i++) {
            const c = st.centers[i];
            if (!c) continue;
            let dy = 0;
            let tilt = 0;
            for (const wv of st.waves) {
              const a = (now - wv.t0) / 1000;
              const d = Math.hypot(c.x - wv.x, c.y - wv.y);
              const front = V * a;
              const env = Math.exp(-((d - front) * (d - front)) / (2 * PW * PW));
              const decay = Math.exp(-a / TAU);
              const spatial = Math.exp(-d / D);
              const base = AMP * decay * spatial * env;
              const phase = ((d - front) / WL) * Math.PI * 2;
              dy += base * Math.sin(phase);
              tilt += base * Math.cos(phase); // surface slope -> lean/stretch
            }
            const el2 = st.letters[i];
            if (Math.abs(dy) < 0.05 && Math.abs(tilt) < 0.05) {
              if (el2.style.transform) el2.style.transform = '';
              continue;
            }
            // Warp the letterform: vertical stretch at crests, shear with slope.
            const sy = 1 + Math.min(0.18, (Math.abs(dy) / AMP) * 0.18);
            const skew = Math.max(-9, Math.min(9, tilt * 0.85));
            el2.style.transform =
              'translate3d(' + (dy * 0.1).toFixed(2) + 'px,' + dy.toFixed(2) +
              'px,0) scaleY(' + sy.toFixed(3) + ') skewX(' + skew.toFixed(2) + 'deg)';
          }
          if (st.waves.length) {
            st.raf = requestAnimationFrame(() => frame(el));
          } else {
            st.raf = 0;
            st.letters.forEach((l) => (l.style.transform = ''));
          }
        };

        window.addEventListener(
          'pointermove',
          (e) => {
            const el = (e.target as Element)?.closest?.('.hl');
            if (!el) return;
            const st = ensure(el);
            const now = performance.now();
            // Drop a new ripple only every so often, and only once the cursor
            // has actually travelled a little, so it does not blur into one mass.
            const moved = Math.hypot(e.clientX - st.lastX, e.clientY - st.lastY);
            if (now - st.lastInject < 110 || moved < 14) return;
            st.lastInject = now;
            st.lastX = e.clientX;
            st.lastY = e.clientY;
            if (now - st.lastMeasure > 200) measure(st);
            st.waves.push({ x: e.clientX, y: e.clientY, t0: now });
            if (st.waves.length > 8) st.waves.shift();
            if (!st.raf) st.raf = requestAnimationFrame(() => frame(el));
          },
          { passive: true }
        );
        window.addEventListener('resize', () => {
          // Re-measure any split headings on layout change.
          document.querySelectorAll('.hl[data-split]').forEach((el) => {
            const st = states.get(el);
            if (st) measure(st);
          });
        });
      }
    </script>
  </body>
</html>
