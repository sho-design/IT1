---
import type { Family } from '../data/families';
export interface Props {
  family: Family;
}
const { family } = Astro.props;
---

<a class="card" href={`/treatments/${family.key}`} style={`--accent:${family.accent}`}>
  <span class="card__rule" aria-hidden="true"></span>
  <span class="card__fam">{family.label}</span>
  <span class="card__blurb">{family.blurb}</span>
  <span class="card__more link-arrow">See treatments &rarr;</span>
</a>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 1.7rem 1.4rem 1.3rem;
    background: var(--white-pure);
    background-image: var(--gloss-white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .card__rule {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--accent);
    opacity: 0.85;
  }
  .card__fam {
    font-family: var(--display);
    font-size: var(--step-2);
    color: var(--ink);
    margin-top: 0.3rem;
  }
  .card__blurb {
    color: var(--graphite);
    font-size: var(--step--1);
  }
  .card__more {
    margin-top: 0.4rem;
    border-color: transparent;
  }
  @media (hover: hover) {
    .card:hover {
      border-color: var(--accent);
      transform: translateY(-3px);
      box-shadow: 0 18px 34px -22px rgba(26, 27, 29, 0.32);
    }
    .card:hover .card__more {
      border-color: var(--ink);
    }
  }
</style>
