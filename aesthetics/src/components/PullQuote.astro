---
export interface Props {
  cite?: string;
  accent?: string;
}
const { cite = 'Refined by Medicine', accent = 'var(--accent-injectables)' } =
  Astro.props;
---

<figure class="pq reveal" style={`--pq-accent:${accent}`}>
  <span class="pq__mark" aria-hidden="true"></span>
  <blockquote class="pq__q"><slot /></blockquote>
  <figcaption class="pq__cite">{cite}</figcaption>
</figure>

<style>
  .pq {
    margin: 0;
    padding-block: clamp(3rem, 7vw, 6rem);
    display: grid;
    justify-items: center;
    gap: 1.3rem;
    text-align: center;
  }
  .pq__mark {
    width: 38px;
    height: 3px;
    border-radius: 3px;
    background: var(--pq-accent);
  }
  .pq__q {
    margin: 0;
    font-family: var(--display);
    font-weight: 360;
    font-size: var(--step-4);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 20ch;
    text-wrap: balance;
  }
  .pq__cite {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mist);
  }
</style>
