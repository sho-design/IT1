---
import { site } from '../data/site';
---

<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="wrap hero__in">
    <p class="eyebrow in-load">{site.line} · Refined by Medicine</p>
    <h1 class="hl hero__title in-load" style="--load-delay: 90ms">
      Look like <span class="it">yourself, refined.</span>
    </h1>
    <p class="lead hero__lead in-load" style="--load-delay: 180ms">{site.lead}</p>
    <div class="hero__actions in-load" style="--load-delay: 260ms">
      <a class="btn btn--lg" href="/book">Book a consult</a>
      <a class="link-arrow" href="/#treatments">Explore treatments &rarr;</a>
    </div>
    <div class="hero__meta in-load" style="--load-delay: 340ms">
      <span class="meta">Physician-led</span>
      <span class="hero__sep" aria-hidden="true"></span>
      <span class="meta">Natural-looking</span>
      <span class="hero__sep" aria-hidden="true"></span>
      <span class="meta">No pressure, ever</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vh, 8rem) var(--space-l);
  }
  /* Light-bloom motif (replaces the infusion line's IV bag). */
  .hero__glow {
    position: absolute;
    inset: -22% -12% auto auto;
    width: min(62vw, 760px);
    height: min(62vw, 760px);
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in srgb, var(--accent-skin) 55%, transparent),
      color-mix(in srgb, var(--accent-injectables) 28%, transparent) 38%,
      transparent 68%
    );
    filter: blur(30px);
    opacity: 0.5;
    animation: hero-float 16s var(--ease) infinite alternate;
    pointer-events: none;
  }
  @keyframes hero-float {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(-6%, 5%) scale(1.08);
    }
  }
  .hero__in {
    position: relative;
    z-index: 1;
    max-width: 42ch;
  }
  .hero__title {
    font-size: var(--step-5);
    margin-top: 1.2rem;
  }
  .hero__lead {
    margin-top: 1.6rem;
    max-width: 46ch;
  }
  .hero__actions {
    margin-top: 2.2rem;
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-wrap: wrap;
  }
  .hero__meta {
    margin-top: 3rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: 1.4rem;
  }
  .hero__sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--line);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__glow {
      animation: none;
    }
  }
</style>
