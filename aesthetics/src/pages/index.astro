---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ConcernTile from '../components/ConcernTile.astro';
import TreatmentCard from '../components/TreatmentCard.astro';
import EvidenceTag from '../components/EvidenceTag.astro';
import PullQuote from '../components/PullQuote.astro';
import CtaBand from '../components/CtaBand.astro';
import { concerns } from '../data/concerns';
import { families } from '../data/families';
import { modalities } from '../data/modalities';
---

<Layout title="Home">
  <Hero />

  <section id="concerns" class="section fill">
    <div class="wrap">
      <div class="reveal sec-head">
        <p class="eyebrow">Start with how you feel</p>
        <h2 class="hl sec-head__h">What would you refine?</h2>
      </div>
      <div class="grid reveal">
        {concerns.map((c) => <ConcernTile concern={c} />)}
      </div>
    </div>
  </section>

  <section id="treatments" class="section">
    <div class="wrap">
      <div class="reveal sec-head">
        <p class="eyebrow">Browse our treatments</p>
        <h2 class="hl sec-head__h">Families, one standard.</h2>
      </div>
      <div class="grid reveal">
        {families.map((f) => <TreatmentCard family={f} />)}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <PullQuote cite="Refined by Medicine" accent="var(--accent-injectables)">
        Subtle by design. <span class="it">You, on a good day.</span>
      </PullQuote>
    </div>
  </section>

  <section id="modalities" class="section fill">
    <div class="wrap">
      <div class="reveal sec-head">
        <p class="eyebrow">The actives, honestly</p>
        <h2 class="hl sec-head__h">What we use, and what the evidence says.</h2>
      </div>
      <div class="mods reveal">
        {modalities.map((m) => (
          <div class="mod" style={`--accent:var(--accent-${m.family})`}>
            <span class="mod__dot" aria-hidden="true"></span>
            <span class="mod__name">{m.name}</span>
            <span class="mod__line" set:html={m.oneLine}></span>
            <EvidenceTag level={m.evidence} note={m.note} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .sec-head {
    display: grid;
    gap: 0.6rem;
    margin-bottom: var(--space-m);
    max-width: 60ch;
  }
  .sec-head__h {
    font-size: var(--step-3);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }
  .mods {
    display: grid;
    gap: 0.6rem;
  }
  .mod {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.4rem 0.9rem;
    padding: 0.9rem 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .mod__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }
  .mod__name {
    font-size: var(--step-0);
    color: var(--ink);
  }
  .mod__line {
    grid-column: 2;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--mist);
  }
  .mod :global(.ev) {
    grid-row: 1 / span 2;
    grid-column: 3;
  }
  @media (max-width: 680px) {
    .mod {
      grid-template-columns: auto 1fr;
    }
    .mod :global(.ev) {
      grid-row: auto;
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
